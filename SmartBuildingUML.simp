                <operation id="o9ddbb041b58e4bdaa653a27898cd7ec9242" cid="OP007" name="test_reading_validation_and_unit_conversion" creation-date="10/09/2026 22:14:52" type="" type-id="" visibility="public">
                  <tagged-values>
                    <tagged-value id="tv9b3509c089d243e0853cfd37dfc00624" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_reading_validation_and_unit_conversion" />
                    <tagged-value id="tv07147229a5274958bd9d7bb5bd0524f7" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_sensors.py" />
                    <tagged-value id="tv1c472dbe7a884fc49563c9a398bebf5a" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tv491108ecbeba4cc0bb437c8e653c100d" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="3955" />
                    <tagged-value id="tv09c5852f507c495f83b046e2b0c54e00" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="933" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                                  
    valid_reading = SensorReading("r1", "t1", datetime.now(), 25.0, "C")
    assert valid_reading.is_valid() is True

                                                   
    f_val = valid_reading.convert_unit("F")
    assert round(f_val, 2) == 77.0

                                             
    k_val = valid_reading.convert_unit("K")
    assert round(k_val, 2) == 298.15

                               
    power_reading = SensorReading("r2", "e1", datetime.now(), 5.0, "kW")
    w_val = power_reading.convert_unit("W")
    assert w_val == 5000.0

                           
    nan_reading = SensorReading("r3", "t1", datetime.now(), float("nan"), "C")
    assert nan_reading.is_valid() is False

                            
    with pytest.raises(ValueError):
        valid_reading.convert_unit("meter")
</source-code>
                  </source-codes>
                </operation>
                <operation id="oc46a13f4557244bca54e6ce34d2088fb243" cid="OP008" name="test_in_memory_repository_crud" creation-date="10/09/2026 22:14:52" type="" type-id="" visibility="public">
                  <tagged-values>
                    <tagged-value id="tve0eeb7a803c848de983d9ee314d4cdfb" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_in_memory_repository_crud" />
                    <tagged-value id="tv96b53b14e3e6449895d0f82ee3851979" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_repositories.py" />
                    <tagged-value id="tv400ec3cea86b473796911f8a3c314638" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tv99a8593be5f74300abdf6fea7bc72af6" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="585" />
                    <tagged-value id="tvfd703fa7f3704e6b901806c455538b16" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="982" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                             
    repo = InMemoryRepository[TemperatureSensor]()
    sensor1 = TemperatureSensor(id="s1", name="Sensor One")
    sensor2 = TemperatureSensor(id="s2", name="Sensor Two")

         
    repo.add(sensor1)
    repo.add(sensor2)
    assert repo.count() == 2

               
    fetched = repo.get_by_id("s1")
    assert fetched == sensor1
    assert repo.get_by_id("non-existent") is None

             
    all_sensors = repo.get_all()
    assert len(all_sensors) == 2
    assert sensor1 in all_sensors

            
    sensor1.name = "Sensor One Renamed"
    updated = repo.update(sensor1)
    assert updated is True
    assert repo.get_by_id("s1").name == "Sensor One Renamed"

            
    deleted = repo.delete("s1")
    assert deleted is True
    assert repo.get_by_id("s1") is None
    assert repo.count() == 1

           
    repo.clear()
    assert repo.count() == 0


</source-code>
                  </source-codes>
                </operation>
                <operation id="o8ad2cb0cd8a9415cb4723dfe0cccff7a243" cid="OP009" name="test_sensor_repository_queries" creation-date="10/09/2026 22:14:52" type="" type-id="" visibility="public">
                  <tagged-values>
                    <tagged-value id="tvc802852fffb3448ab47bd610b2ac6852" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_sensor_repository_queries" />
                    <tagged-value id="tv73b560e541ce4edeb33e66b737e651bc" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_repositories.py" />
                    <tagged-value id="tv24b2ed3d9d4d414dba95dbf33388aa8f" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tvce6ebadb54e7420c9ff8a33bf0c58a28" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="1567" />
                    <tagged-value id="tve084961a50c841079d59b847f70247cb" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="856" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                          
    repo = SensorRepository()
    s1 = TemperatureSensor(id="s1", name="Room A Temp", room_id="rm-A")
    s2 = TemperatureSensor(id="s2", name="Room B Temp", room_id="rm-B")
    s3 = TemperatureSensor(id="s3", name="Room A Backup", room_id="rm-A")
    s3.status = SensorStatus.OFFLINE

    repo.add(s1)
    repo.add(s2)
    repo.add(s3)

                    
    room_a_sensors = repo.get_by_room_id("rm-A")
    assert len(room_a_sensors) == 2
    assert s1 in room_a_sensors
    assert s3 in room_a_sensors

                   
    offline_sensors = repo.get_by_status(SensorStatus.OFFLINE)
    assert len(offline_sensors) == 1
    assert offline_sensors[0] == s3

                                            
    assert repo.get_offline_sensors() == [s3]


</source-code>
                  </source-codes>
                </operation>
                <operation id="o7da909b7f65c4a29821f3158d572a8a3243" cid="OP010" name="test_reading_repository_queries" creation-date="10/09/2026 22:14:52" type="" type-id="" visibility="public">
                  <tagged-values>
                    <tagged-value id="tvbf89257b8677411a8d98f62920084984" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_reading_repository_queries" />
                    <tagged-value id="tv26ae7eb99e3c42e58ad613cac4be315a" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_repositories.py" />
                    <tagged-value id="tv757ebbebab4b47e0a194cdf3ff712dcf" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tv76b85be2370745fa9732ac607a1362cd" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="2423" />
                    <tagged-value id="tv564d3fc7df664409b52d1bf14346dbdd" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="1122" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                           
    repo = ReadingRepository()
    t0 = datetime.now() - timedelta(minutes=10)
    t1 = datetime.now() - timedelta(minutes=5)
    t2 = datetime.now()

    r1 = SensorReading(id="r1", sensor_id="s1", timestamp=t0, value=20.0, unit="C")
    r2 = SensorReading(id="r2", sensor_id="s1", timestamp=t1, value=22.0, unit="C")
    r3 = SensorReading(id="r3", sensor_id="s1", timestamp=t2, value=25.0, unit="C")
    r4 = SensorReading(id="r4", sensor_id="s2", timestamp=t2, value=50.0, unit="%")

    repo.add(r1)
    repo.add(r2)
    repo.add(r3)
    repo.add(r4)

                      
    s1_readings = repo.get_by_sensor_id("s1")
    assert len(s1_readings) == 3

                        
    latest_s1 = repo.get_latest_reading("s1")
    assert latest_s1 is not None
    assert latest_s1.id == "r3"
    assert latest_s1.value == 25.0

                        
    recent = repo.get_readings_since("s1", since=datetime.now() - timedelta(minutes=7))
    assert len(recent) == 2
    assert r2 in recent
    assert r3 in recent


</source-code>
                  </source-codes>
                </operation>
                <operation id="od658e1851fe1409d98db78222e09ad6d243" cid="OP011" name="test_alert_repository_queries" creation-date="10/09/2026 22:14:52" type="" type-id="" visibility="public">
                  <tagged-values>
                    <tagged-value id="tv98372488d50246c3889e0ed1c2485c6c" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_alert_repository_queries" />
                    <tagged-value id="tvfd597651152b4e15aec062b2a1d80d2d" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_repositories.py" />
                    <tagged-value id="tvfbb7f81350f44942b23247a574a20305" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tvbde9209907ea4fba946f5a885ad7a997" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="3545" />
                    <tagged-value id="tv7f69de3007de41af949fd530c4a51298" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="810" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                  
    repo = AlertRepository()
    a1 = Alert(id="a1", sensor_id="s1", message="Warning 1", severity=AlertSeverity.WARNING, status=AlertStatus.OPEN)
    a2 = Alert(id="a2", sensor_id="s1", message="Critical 1", severity=AlertSeverity.CRITICAL, status=AlertStatus.OPEN)
    a3 = Alert(id="a3", sensor_id="s2", message="Info 1", severity=AlertSeverity.INFO, status=AlertStatus.RESOLVED)

    repo.add(a1)
    repo.add(a2)
    repo.add(a3)

    assert len(repo.get_by_sensor_id("s1")) == 2
    assert len(repo.get_open_alerts()) == 2
    assert len(repo.get_by_severity(AlertSeverity.CRITICAL)) == 1
    assert repo.get_by_severity(AlertSeverity.CRITICAL)[0] == a2
    assert len(repo.get_by_status(AlertStatus.RESOLVED)) == 1
</source-code>
                  </source-codes>
                </operation>
                <operation id="ob136f7a0480b403ab4c5ef1757e3690b243" cid="OP012" name="test_setup" creation-date="10/09/2026 22:14:52" type="" type-id="" visibility="public">
                  <tagged-values>
                    <tagged-value id="tv3318d05c1d4c4c9098b8517e5109d2d0" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_setup" />
                    <tagged-value id="tvfa53b136ecb74b878ecca332bac46bec" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_monitoring.py" />
                    <tagged-value id="tv5a7887ed4cb0466cae9d61d6fc9a3f2e" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tv9ef033cbd6ba4b3d9477d6fc64f6b583" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="916" />
                    <tagged-value id="tv86d6ac84a2384d23a7f24bfda71c9c9d" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="1033" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                              
    sensor_repo = SensorRepository()
    reading_repo = ReadingRepository()
    alert_repo = AlertRepository()
    notification_svc = ConsoleNotificationService()
    alert_svc = AlertService(
        alert_repository=alert_repo,
        notification_service=notification_svc,
        notification_recipient="test-admin@building.local",
    )
    monitoring_svc = MonitoringService(
        sensor_repository=sensor_repo,
        reading_repository=reading_repo,
        alert_service=alert_svc,
    )
    reporting_svc = ReportingService(
        sensor_repository=sensor_repo,
        reading_repository=reading_repo,
        alert_repository=alert_repo,
    )
    return {
        "sensor_repo": sensor_repo,
        "reading_repo": reading_repo,
        "alert_repo": alert_repo,
        "notification_svc": notification_svc,
        "alert_svc": alert_svc,
        "monitoring_svc": monitoring_svc,
        "reporting_svc": reporting_svc,
    }


</source-code>
                  </source-codes>
                </operation>
