                <operation id="o054bec4b3cf94edf831b74c492a08591427" cid="OP012" name="test_setup" creation-date="10/09/2026 22:07:56" type="" type-id="" visibility="public">
                  <tagged-values>
                    <tagged-value id="tv7f24fd8b363a40799b37e34147436847" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_setup" />
                    <tagged-value id="tvf11e37cc00c3457797dc11eb470bda20" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_monitoring.py" />
                    <tagged-value id="tv2fdbd18f2ca74153bfa738903cee792a" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tvd4082823888a4840a183fcdd75dd8ec9" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="916" />
                    <tagged-value id="tvccc19313370243a0b44a58096c2fa70a" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="1033" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                              
    sensor_repo = SensorRepository()
    reading_repo = ReadingRepository()
    alert_repo = AlertRepository()
    notification_svc = ConsoleNotificationService()
    alert_svc = AlertService(
        alert_repository=alert_repo,
        notification_service=notification_svc,
        notification_recipient="test-admin@building.local",
    )
    monitoring_svc = MonitoringService(
        sensor_repository=sensor_repo,
        reading_repository=reading_repo,
        alert_service=alert_svc,
    )
    reporting_svc = ReportingService(
        sensor_repository=sensor_repo,
        reading_repository=reading_repo,
        alert_repository=alert_repo,
    )
    return {
        "sensor_repo": sensor_repo,
        "reading_repo": reading_repo,
        "alert_repo": alert_repo,
        "notification_svc": notification_svc,
        "alert_svc": alert_svc,
        "monitoring_svc": monitoring_svc,
        "reporting_svc": reporting_svc,
    }


</source-code>
                  </source-codes>
                </operation>
