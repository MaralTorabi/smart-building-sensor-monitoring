            <operation id="o262093a363914c2da870c4b5f41940dc585" cid="OP002" name="test_sensor_state_transitions" creation-date="10/09/2026 22:14:36" type="" type-id="" visibility="public">
              <tagged-values>
                <tagged-value id="tv5961baddfdf5499091daf75e03e674f7" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_sensor_state_transitions" />
                <tagged-value id="tv7e4d24c372a348ea9963f045f94b8611" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_sensors.py" />
                <tagged-value id="tv00be38805aa9432390dd3664af2bc7fd" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                <tagged-value id="tvcef5451db2984f858f8ae21dee038708" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="1326" />
                <tagged-value id="tv49457e8157344184813e9945ca5e7a31" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="475" />
              </tagged-values>
              <source-codes>
                <source-code language="Python">                                                       
    sensor = TemperatureSensor(id="t1", name="Temp 1")
    assert sensor.is_online() is True

    sensor.disable()
    assert sensor.enabled is False
    assert sensor.status == SensorStatus.DISABLED
    assert sensor.is_online() is False

    sensor.enable()
    assert sensor.enabled is True
    assert sensor.status == SensorStatus.ONLINE
    assert sensor.is_online() is True


</source-code>
              </source-codes>
            </operation>
            <operation id="o742c093b2fa94f8280e0e127670b0aca585" cid="OP003" name="test_room_and_sensor_association" creation-date="10/09/2026 22:14:36" type="" type-id="" visibility="public">
              <tagged-values>
                <tagged-value id="tv13d349b2d0f34c93b94dd6977e5f5a49" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_room_and_sensor_association" />
                <tagged-value id="tvbe075d92838e42c3a3bcbfad37fbbcd1" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_sensors.py" />
                <tagged-value id="tv0e0f7ae23ad74b5ea38bd1d2b7df6b49" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                <tagged-value id="tvf03b41b182ba4ed888627d2d4e500b42" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="1801" />
                <tagged-value id="tvc3492e60dd8e4c0f930f0561ecc8d173" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="577" />
              </tagged-values>
              <source-codes>
                <source-code language="Python">                                                                                
    room = Room(id="rm-101", name="Lab A", floor_number=1)
    sensor = TemperatureSensor(id="t1", name="Lab Temp")

    assert sensor.room_id is None
    room.add_sensor(sensor)

    assert sensor in room.sensors
    assert sensor.room_id == "rm-101"
    assert room.get_sensor("t1") == sensor

                   
    removed = room.remove_sensor("t1")
    assert removed is True
    assert sensor.room_id is None
    assert sensor not in room.sensors


</source-code>
              </source-codes>
            </operation>
            <operation id="o98206502ef304278af2dc46bad585a34585" cid="OP004" name="test_building_floor_room_hierarchy" creation-date="10/09/2026 22:14:36" type="" type-id="" visibility="public">
              <tagged-values>
                <tagged-value id="tvc6a1f1cd434942e3be9d9bb726d6fe47" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_building_floor_room_hierarchy" />
                <tagged-value id="tv449da5429b2649f9a1ce0275ea7608d3" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_sensors.py" />
                <tagged-value id="tv867fd407a35945eca1ee1d7faa48ea0e" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                <tagged-value id="tv2a6a579231f843718ad89a17f1a35f2f" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="2378" />
                <tagged-value id="tvfea3bb2efcc847118ec691feb8cb1656" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="807" />
              </tagged-values>
              <source-codes>
                <source-code language="Python">                                                           
    bldg = Building(id="b1", name="Tower A", address="123 Tech St")
    fl1 = Floor(id="f1", number=1)
    rm1 = Room(id="r1", name="Server Room", floor_number=1)
    s1 = TemperatureSensor(id="s1", name="Rack Temp")
    s2 = HumiditySensor(id="s2", name="Rack Humidity")

    rm1.add_sensor(s1)
    rm1.add_sensor(s2)
    fl1.add_room(rm1)
    bldg.add_floor(fl1)

    assert fl1.building_id == "b1"
    assert rm1.floor_number == 1
    assert len(bldg.get_all_sensors()) == 2
    assert s1 in bldg.get_all_sensors()
    assert s2 in bldg.get_all_sensors()

                    
    assert fl1.remove_room("r1") is True
    assert fl1.get_room("r1") is None
    assert len(bldg.get_all_sensors()) == 0


</source-code>
              </source-codes>
            </operation>
            <operation id="of59d83abc0a14948a927f76ce510849c585" cid="OP005" name="test_sensor_create_reading" creation-date="10/09/2026 22:14:36" type="" type-id="" visibility="public">
