                <operation id="o64f83f0f6b7b4346b99b51170ae04363428" cid="OP017" name="test_detect_offline_sensor" creation-date="10/09/2026 22:07:56" type="" type-id="" visibility="public">
                  <parameters>
                    <parameter id="p07fd142339024ad28f5f907e7aa5b991" name="test_setup" type="" type-id="" creation-date="10/09/2026 22:07:56" />
                  </parameters>
                  <tagged-values>
                    <tagged-value id="tv05d1c55eed804c4fb61e5980074dd3c1" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_detect_offline_sensor" />
                    <tagged-value id="tvd081d8787eac4072b8e716a1c9cf91c0" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_monitoring.py" />
                    <tagged-value id="tv7dfb00ae006f4c6da3cb7e250cb26ffd" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tv8f3034ec6bc44e1180f63569c3b1f495" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="5049" />
                    <tagged-value id="tv4bacf7ddb6fc4d6c9b0ce48fa5b90f54" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="904" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                                                 
    sensor_repo = test_setup["sensor_repo"]
    monitoring_svc = test_setup["monitoring_svc"]

                                      
    s1 = TemperatureSensor(id="s1", name="Active Sensor")
    s1.last_reading_time = datetime.now()
    sensor_repo.add(s1)

                                                         
    s2 = TemperatureSensor(id="s2", name="Dead Sensor")
    s2.last_reading_time = datetime.now() - timedelta(minutes=10)
    sensor_repo.add(s2)

    alerts = monitoring_svc.detect_offline_sensor(timeout_seconds=300.0)
    assert len(alerts) == 1
    assert alerts[0].sensor_id == "s2"
    assert alerts[0].severity == AlertSeverity.CRITICAL

                                            
    assert sensor_repo.get_by_id("s2").status == SensorStatus.OFFLINE


</source-code>
                  </source-codes>
                </operation>
                <operation id="ob626cfd0e8984db1a28a30cd8a0a5383428" cid="OP018" name="test_reporting_service_aggregations" creation-date="10/09/2026 22:07:56" type="" type-id="" visibility="public">
                  <parameters>
                    <parameter id="p3b3fba75d49c436ebeb52f74a0efe828" name="test_setup" type="" type-id="" creation-date="10/09/2026 22:07:56" />
                  </parameters>
                  <tagged-values>
                    <tagged-value id="tv824e0f63ddaf4aa1946d9a75760c4370" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_reporting_service_aggregations" />
                    <tagged-value id="tv2d53be35c8ba40d5b047862586b81800" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_monitoring.py" />
                    <tagged-value id="tvc551194a458a43c89facb58fdb45a34f" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tva447872770e0487bb5417aaec71474e9" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="5953" />
                    <tagged-value id="tv80412bb3f89f4921830a92ee7f3a8165" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="1384" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                                          
    sensor_repo = test_setup["sensor_repo"]
    reading_repo = test_setup["reading_repo"]
    reporting_svc = test_setup["reporting_svc"]

    sensor = TemperatureSensor(id="s_stat", name="Stat Temp Sensor")
    sensor_repo.add(sensor)

    reading_repo.add(SensorReading("r1", "s_stat", datetime.now(), 20.0, "C"))
    reading_repo.add(SensorReading("r2", "s_stat", datetime.now(), 30.0, "C"))
    reading_repo.add(SensorReading("r3", "s_stat", datetime.now(), 25.0, "C"))

    assert reporting_svc.calculate_min_reading("s_stat") == 20.0
    assert reporting_svc.calculate_max_reading("s_stat") == 30.0
    assert reporting_svc.calculate_average_reading("s_stat") == 25.0

                   
    sensor_rep = reporting_svc.generate_sensor_report("s_stat")
    assert sensor_rep["sensor_id"] == "s_stat"
    assert sensor_rep["total_readings"] == 3

                     
    bldg = Building("b1", "Alpha Center", "10 Innovation Blvd")
    fl = Floor("f1", 1)
    rm = Room("r1", "Main Hall", 1)
    rm.add_sensor(sensor)
    fl.add_room(rm)
    bldg.add_floor(fl)

    bldg_rep = reporting_svc.generate_building_report(bldg)
    assert bldg_rep["building_id"] == "b1"
    assert bldg_rep["total_sensors"] == 1
    assert bldg_rep["online_sensors"] == 1
</source-code>
                  </source-codes>
                </operation>
              </operations>
            </item>
