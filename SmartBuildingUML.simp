            <operation id="o277c8b176a03497988ddc788de1a86b6976" cid="OP008" name="test_in_memory_repository_crud" creation-date="10/09/2026 22:15:14" type="" type-id="" visibility="public">
              <tagged-values>
                <tagged-value id="tvad270ee6fdcd413eb66bbedb4c5e2821" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_in_memory_repository_crud" />
                <tagged-value id="tvfd7ed0cd24ff41b49af26299fe10b3b6" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_repositories.py" />
                <tagged-value id="tv150a63019b0a4102afdd16056f2f78a3" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                <tagged-value id="tv5918ad23e5124053a61f835dce50d1de" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="585" />
                <tagged-value id="tv58ed9dd717954717a3cb3b9eec95c783" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="982" />
              </tagged-values>
              <source-codes>
                <source-code language="Python">                                                             
    repo = InMemoryRepository[TemperatureSensor]()
    sensor1 = TemperatureSensor(id="s1", name="Sensor One")
    sensor2 = TemperatureSensor(id="s2", name="Sensor Two")

         
    repo.add(sensor1)
    repo.add(sensor2)
    assert repo.count() == 2

               
    fetched = repo.get_by_id("s1")
    assert fetched == sensor1
    assert repo.get_by_id("non-existent") is None

             
    all_sensors = repo.get_all()
    assert len(all_sensors) == 2
    assert sensor1 in all_sensors

            
    sensor1.name = "Sensor One Renamed"
    updated = repo.update(sensor1)
    assert updated is True
    assert repo.get_by_id("s1").name == "Sensor One Renamed"

            
    deleted = repo.delete("s1")
    assert deleted is True
    assert repo.get_by_id("s1") is None
    assert repo.count() == 1

           
    repo.clear()
    assert repo.count() == 0


</source-code>
              </source-codes>
            </operation>
            <operation id="o2b905de0350748bfbe423cac8a0b945f976" cid="OP009" name="test_sensor_repository_queries" creation-date="10/09/2026 22:15:14" type="" type-id="" visibility="public">
              <tagged-values>
