                    <tagged-value id="tv665835a7796549dbbf5877cbdc7ad5cb" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_monitoring.py" />
