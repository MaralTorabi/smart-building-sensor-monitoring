            <operation id="of2c78792e16544f393b78d1f85727dc8977" cid="OP015" name="test_alert_lifecycle_workflow" creation-date="10/09/2026 22:15:14" type="" type-id="" visibility="public">
              <parameters>
                <parameter id="p0543d239a28943239edd96186dfef967" name="test_setup" type="" type-id="" creation-date="10/09/2026 22:15:14" />
              </parameters>
              <tagged-values>
                <tagged-value id="tv3728f14a65e5424d856d6a07d24bd405" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_alert_lifecycle_workflow" />
                <tagged-value id="tv04ddf5764d5f46729c5c7f5f5f0c34fd" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_monitoring.py" />
                <tagged-value id="tv69a71c05d3b049508caf08dd63029e76" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                <tagged-value id="tv55d61172c8834c2888be9bb7044fd9e5" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="3411" />
                <tagged-value id="tva5693eac2d4b422fa6baee99aad6cbad" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="912" />
              </tagged-values>
              <source-codes>
                <source-code language="Python">                                                               
    alert_svc = test_setup["alert_svc"]
    alert = alert_svc.create_alert(
        sensor_id="s1",
        message="High temperature warning",
        severity=AlertSeverity.WARNING,
    )
    assert alert.status == AlertStatus.OPEN
    assert alert.acknowledged_at is None
    assert alert.resolved_at is None

                 
    ack_alert = alert_svc.acknowledge_alert(alert.id)
    assert ack_alert is not None
    assert ack_alert.status == AlertStatus.ACKNOWLEDGED
    assert ack_alert.acknowledged_at is not None

             
    res_alert = alert_svc.resolve_alert(alert.id)
    assert res_alert is not None
    assert res_alert.status == AlertStatus.RESOLVED
    assert res_alert.resolved_at is not None

                              
    assert len(alert_svc.get_open_alerts()) == 0


</source-code>
              </source-codes>
            </operation>
            <operation id="o48b82e6bae574aa8bce4bca5da43a51b977" cid="OP016" name="test_notification_delivery_dispatch" creation-date="10/09/2026 22:15:14" type="" type-id="" visibility="public">
              <tagged-values>
                <tagged-value id="tvbe6a693cae064f078062f018bbfc4c69" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_notification_delivery_dispatch" />
                <tagged-value id="tvf63400fa0e0a49ec8cd25014fd90bf78" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_monitoring.py" />
                <tagged-value id="tvd6944789c71742548515e413a0601449" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                <tagged-value id="tv856c320f5f1d429ca32a27c78b199c11" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="4323" />
                <tagged-value id="tv596311ec4bbc4663aeaa7dc1c4a4fc13" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="726" />
              </tagged-values>
              <source-codes>
                <source-code language="Python">                                                                           
    alert_repo = AlertRepository()
    email_svc = EmailNotificationService(sender_email="alerts@test.local")
    alert_svc = AlertService(
        alert_repository=alert_repo,
        notification_service=email_svc,
        notification_recipient="ops@test.local",
    )

    alert_svc.create_alert(
        sensor_id="s99",
        message="Critical leak detected",
        severity=AlertSeverity.CRITICAL,
    )
    assert len(email_svc.sent_emails) == 1
    assert email_svc.sent_emails[0]["to"] == "ops@test.local"
    assert email_svc.sent_emails[0]["subject"] == "[CRITICAL] Building Sensor Alert"


</source-code>
              </source-codes>
            </operation>
            <operation id="ocdf2370dacf34a748a168db0db8e883e977" cid="OP017" name="test_detect_offline_sensor" creation-date="10/09/2026 22:15:14" type="" type-id="" visibility="public">
              <parameters>
                <parameter id="pe5c9dbfa064049b2872dd4ec9362ca2e" name="test_setup" type="" type-id="" creation-date="10/09/2026 22:15:14" />
              </parameters>
              <tagged-values>
                <tagged-value id="tv9f70cd74c87f46ddabd79c370a2c4a69" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_detect_offline_sensor" />
                <tagged-value id="tv15ac1173e49c477d8be42a0138d49a94" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_monitoring.py" />
                <tagged-value id="tv60cd5cc72121492981edaf681a468317" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                <tagged-value id="tv7a22f49a869c480592068f47759c6a3c" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="5049" />
                <tagged-value id="tv7d84e0fe18c14f5cab9a4a0250b2bd1f" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="904" />
              </tagged-values>
              <source-codes>
                <source-code language="Python">                                                                                 
    sensor_repo = test_setup["sensor_repo"]
    monitoring_svc = test_setup["monitoring_svc"]

                                      
    s1 = TemperatureSensor(id="s1", name="Active Sensor")
    s1.last_reading_time = datetime.now()
    sensor_repo.add(s1)

                                                         
    s2 = TemperatureSensor(id="s2", name="Dead Sensor")
    s2.last_reading_time = datetime.now() - timedelta(minutes=10)
    sensor_repo.add(s2)

    alerts = monitoring_svc.detect_offline_sensor(timeout_seconds=300.0)
    assert len(alerts) == 1
    assert alerts[0].sensor_id == "s2"
    assert alerts[0].severity == AlertSeverity.CRITICAL

                                            
    assert sensor_repo.get_by_id("s2").status == SensorStatus.OFFLINE


</source-code>
              </source-codes>
            </operation>
            <operation id="oe4a20d2b76784652b61ab3c5f6182c4f977" cid="OP018" name="test_reporting_service_aggregations" creation-date="10/09/2026 22:15:14" type="" type-id="" visibility="public">
              <parameters>
                <parameter id="p5f00430c5a42482db365a14dfd0d8f1f" name="test_setup" type="" type-id="" creation-date="10/09/2026 22:15:14" />
              </parameters>
              <tagged-values>
                <tagged-value id="tv6dbc3f91a869410bbd3561fcda3400cd" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_reporting_service_aggregations" />
                <tagged-value id="tv01840d3e535d4e88a5d9e2f783fe0369" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_monitoring.py" />
                <tagged-value id="tv5c9b33859f574fa1bbadc28f109739f4" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                <tagged-value id="tvc3d903c20b4743c3a10a815e81debe11" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="5953" />
                <tagged-value id="tve9b1481c22a84f2ba2ef65d26d327d49" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="1384" />
              </tagged-values>
              <source-codes>
                <source-code language="Python">                                                                          
    sensor_repo = test_setup["sensor_repo"]
    reading_repo = test_setup["reading_repo"]
    reporting_svc = test_setup["reporting_svc"]

    sensor = TemperatureSensor(id="s_stat", name="Stat Temp Sensor")
    sensor_repo.add(sensor)

    reading_repo.add(SensorReading("r1", "s_stat", datetime.now(), 20.0, "C"))
    reading_repo.add(SensorReading("r2", "s_stat", datetime.now(), 30.0, "C"))
    reading_repo.add(SensorReading("r3", "s_stat", datetime.now(), 25.0, "C"))

    assert reporting_svc.calculate_min_reading("s_stat") == 20.0
    assert reporting_svc.calculate_max_reading("s_stat") == 30.0
    assert reporting_svc.calculate_average_reading("s_stat") == 25.0

                   
    sensor_rep = reporting_svc.generate_sensor_report("s_stat")
    assert sensor_rep["sensor_id"] == "s_stat"
    assert sensor_rep["total_readings"] == 3

                     
    bldg = Building("b1", "Alpha Center", "10 Innovation Blvd")
    fl = Floor("f1", 1)
    rm = Room("r1", "Main Hall", 1)
    rm.add_sensor(sensor)
    fl.add_room(rm)
    bldg.add_floor(fl)

    bldg_rep = reporting_svc.generate_building_report(bldg)
    assert bldg_rep["building_id"] == "b1"
    assert bldg_rep["total_sensors"] == 1
    assert bldg_rep["online_sensors"] == 1
</source-code>
              </source-codes>
            </operation>
          </operations>
