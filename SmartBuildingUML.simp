                <operation id="o49b8c8ca884c4536b180e01aaef17f33243" cid="OP015" name="test_alert_lifecycle_workflow" creation-date="10/09/2026 22:14:52" type="" type-id="" visibility="public">
                  <parameters>
                    <parameter id="p0280075be05d45bcb303575192f5c261" name="test_setup" type="" type-id="" creation-date="10/09/2026 22:14:52" />
                  </parameters>
                  <tagged-values>
                    <tagged-value id="tvaa2e3bbf0494472da8151557ac92706f" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_alert_lifecycle_workflow" />
                    <tagged-value id="tv575948c50ace416bb67c746cd5cca7e7" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_monitoring.py" />
                    <tagged-value id="tvd513cfc8e5d444ddba35e7f74780e99f" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tvba6854bc4d884199aa0ecde511c75336" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="3411" />
                    <tagged-value id="tv58edc82a69bd4d7cb1330c43de675963" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="912" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                               
    alert_svc = test_setup["alert_svc"]
    alert = alert_svc.create_alert(
        sensor_id="s1",
        message="High temperature warning",
        severity=AlertSeverity.WARNING,
    )
    assert alert.status == AlertStatus.OPEN
    assert alert.acknowledged_at is None
    assert alert.resolved_at is None

                 
    ack_alert = alert_svc.acknowledge_alert(alert.id)
    assert ack_alert is not None
    assert ack_alert.status == AlertStatus.ACKNOWLEDGED
    assert ack_alert.acknowledged_at is not None

             
    res_alert = alert_svc.resolve_alert(alert.id)
    assert res_alert is not None
    assert res_alert.status == AlertStatus.RESOLVED
    assert res_alert.resolved_at is not None

                              
    assert len(alert_svc.get_open_alerts()) == 0


</source-code>
                  </source-codes>
                </operation>
                <operation id="o31e81776a82144cbaeb4603137aa2806243" cid="OP016" name="test_notification_delivery_dispatch" creation-date="10/09/2026 22:14:52" type="" type-id="" visibility="public">
