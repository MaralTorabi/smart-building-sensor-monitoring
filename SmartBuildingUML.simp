                <tagged-value id="tv952e065eb45e44b98099dac2bd7357cd" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\src\service\alert.py" />
