                <operation id="o228170c086f643b683e8374485e0870d242" cid="OP001" name="test_sensor_instantiation_and_inheritance" creation-date="10/09/2026 22:14:52" type="" type-id="" visibility="public">
                  <tagged-values>
                    <tagged-value id="tvc6afb591d2c24266ae65d1a89ae9ee59" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_sensor_instantiation_and_inheritance" />
                    <tagged-value id="tv5ea9e1749b264d4396479a6c0fb3815b" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_sensors.py" />
                    <tagged-value id="tvc4998ccd544e439582484318cb287f96" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tva6876322ba99440e93702f2b94c3e84a" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="613" />
                    <tagged-value id="tv0c8f639a3d914a5087b623206d40d8d8" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="713" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                                                                    
    temp_s = TemperatureSensor(id="t1", name="Temp 1")
    assert temp_s.id == "t1"
    assert temp_s.name == "Temp 1"
    assert temp_s.unit == "C"
    assert temp_s.status == SensorStatus.ONLINE
    assert temp_s.is_online() is True

    co2_s = CO2Sensor(id="c1", name="CO2 1")
    assert co2_s.unit == "ppm"

    hum_s = HumiditySensor(id="h1", name="Hum 1")
    assert hum_s.unit == "%"

    mot_s = MotionSensor(id="m1", name="Motion 1")
    assert mot_s.unit == "motion"

    eng_s = EnergySensor(id="e1", name="Energy 1")
    assert eng_s.unit == "kWh"


</source-code>
                  </source-codes>
                </operation>
                <operation id="o838165873b9247a7a9b6443e111faddf242" cid="OP002" name="test_sensor_state_transitions" creation-date="10/09/2026 22:14:52" type="" type-id="" visibility="public">
                  <tagged-values>
                    <tagged-value id="tvf61997c159164c64b817210022ad4d21" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_sensor_state_transitions" />
                    <tagged-value id="tv1febaeb0731a401c9652de3dc4c76fc2" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_sensors.py" />
                    <tagged-value id="tv56612b98ddb149208339556bd668d89c" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tvaf66a232219748979d6d863106a05bc3" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="1326" />
                    <tagged-value id="tv30cf00b2937047cd83afdb75ae026274" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="475" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                       
    sensor = TemperatureSensor(id="t1", name="Temp 1")
    assert sensor.is_online() is True

    sensor.disable()
    assert sensor.enabled is False
    assert sensor.status == SensorStatus.DISABLED
    assert sensor.is_online() is False

    sensor.enable()
    assert sensor.enabled is True
    assert sensor.status == SensorStatus.ONLINE
    assert sensor.is_online() is True


</source-code>
                  </source-codes>
                </operation>
                <operation id="o020355dde8a24b1388fdb312561bad0b242" cid="OP003" name="test_room_and_sensor_association" creation-date="10/09/2026 22:14:52" type="" type-id="" visibility="public">
                  <tagged-values>
                    <tagged-value id="tvb0de8ed95b9b42ee8a94039b6be0a0c2" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_room_and_sensor_association" />
                    <tagged-value id="tv2b6837b0c72446ffb80c828542e37a7e" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_sensors.py" />
                    <tagged-value id="tva96fdf467e4149f9942f4e5525903c9f" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tvc0662f7009264ca581cf4945a3d8b9eb" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="1801" />
                    <tagged-value id="tv667200deda2b4548bd9a7069c125ea3c" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="577" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                                                
    room = Room(id="rm-101", name="Lab A", floor_number=1)
    sensor = TemperatureSensor(id="t1", name="Lab Temp")

    assert sensor.room_id is None
    room.add_sensor(sensor)

    assert sensor in room.sensors
    assert sensor.room_id == "rm-101"
    assert room.get_sensor("t1") == sensor

                   
    removed = room.remove_sensor("t1")
    assert removed is True
    assert sensor.room_id is None
    assert sensor not in room.sensors


</source-code>
                  </source-codes>
                </operation>
                <operation id="o53ae4b5e2e0c4fda814a2bc593932e01242" cid="OP004" name="test_building_floor_room_hierarchy" creation-date="10/09/2026 22:14:52" type="" type-id="" visibility="public">
                  <tagged-values>
                    <tagged-value id="tv9e350e2b23274e7780583ea887a764b3" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_building_floor_room_hierarchy" />
                    <tagged-value id="tv2fd1dd63e06749128c257cc859ae2e0d" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_sensors.py" />
                    <tagged-value id="tv1f54fcdeae5947248cb576a5ca34ce87" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tv887d81e684cf479f83ee1d2da4d32d5d" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="2378" />
                    <tagged-value id="tv5894632be347457087296142cfef3ca9" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="807" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                           
    bldg = Building(id="b1", name="Tower A", address="123 Tech St")
    fl1 = Floor(id="f1", number=1)
    rm1 = Room(id="r1", name="Server Room", floor_number=1)
    s1 = TemperatureSensor(id="s1", name="Rack Temp")
    s2 = HumiditySensor(id="s2", name="Rack Humidity")

    rm1.add_sensor(s1)
    rm1.add_sensor(s2)
    fl1.add_room(rm1)
    bldg.add_floor(fl1)

    assert fl1.building_id == "b1"
    assert rm1.floor_number == 1
    assert len(bldg.get_all_sensors()) == 2
    assert s1 in bldg.get_all_sensors()
    assert s2 in bldg.get_all_sensors()

                    
    assert fl1.remove_room("r1") is True
    assert fl1.get_room("r1") is None
    assert len(bldg.get_all_sensors()) == 0


</source-code>
                  </source-codes>
                </operation>
                <operation id="oac0f25b2197b46c89ed00983b833f73b242" cid="OP005" name="test_sensor_create_reading" creation-date="10/09/2026 22:14:52" type="" type-id="" visibility="public">
                  <tagged-values>
                    <tagged-value id="tv6436d7a175c14048b18364eeac55ea19" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_sensor_create_reading" />
                    <tagged-value id="tv27bbf07ecf3143f59a6a6de71d6bcc70" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_sensors.py" />
                    <tagged-value id="tv0c98f4bd3ee640ca87c28f3c370c4bb1" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tv36ae1a302f8b48c39d0465b8cefb53f1" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="3185" />
                    <tagged-value id="tv10e4ebadb73441ceb9f19b787b4ebd5b" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="478" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                           
    sensor = TemperatureSensor(id="t1", name="Temp Sensor")
    sensor.set_simulated_value(22.5)

    reading = sensor.create_reading(reading_id="rd-01")
    assert isinstance(reading, SensorReading)
    assert reading.id == "rd-01"
    assert reading.sensor_id == "t1"
    assert reading.value == 22.5
    assert reading.unit == "C"
    assert sensor.last_reading_time is not None


</source-code>
                  </source-codes>
