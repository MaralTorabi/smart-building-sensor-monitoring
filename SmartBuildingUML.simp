                <operation id="od8fae9fb7cb445448c547ff877c03243425" cid="OP007" name="test_reading_validation_and_unit_conversion" creation-date="10/09/2026 22:07:56" type="" type-id="" visibility="public">
                  <tagged-values>
                    <tagged-value id="tv985442955c044908bfd6ff3fb46f0fd0" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_reading_validation_and_unit_conversion" />
                    <tagged-value id="tvcb162b7a7a314751b3c077613a87cc09" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_sensors.py" />
                    <tagged-value id="tv34df727752944b1b8922b4b8c416dcf5" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tv3a0d3cbd00a04faabd66fe116965ced2" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="3955" />
                    <tagged-value id="tv57cf1b88f70e435f88a7da8c23aea7b4" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="933" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                                  
    valid_reading = SensorReading("r1", "t1", datetime.now(), 25.0, "C")
    assert valid_reading.is_valid() is True

                                                   
    f_val = valid_reading.convert_unit("F")
    assert round(f_val, 2) == 77.0

                                             
    k_val = valid_reading.convert_unit("K")
    assert round(k_val, 2) == 298.15

                               
    power_reading = SensorReading("r2", "e1", datetime.now(), 5.0, "kW")
    w_val = power_reading.convert_unit("W")
    assert w_val == 5000.0

                           
    nan_reading = SensorReading("r3", "t1", datetime.now(), float("nan"), "C")
    assert nan_reading.is_valid() is False

                            
    with pytest.raises(ValueError):
        valid_reading.convert_unit("meter")
</source-code>
                  </source-codes>
