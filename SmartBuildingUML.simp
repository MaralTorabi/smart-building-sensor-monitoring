            <item id="2404b3ed8cb04ad894fb4901e189f34e" cid="C028" type="class" creation-date="10/09/2026 22:07:56">
              <operations>
                <operation id="o32f66a03d34b4c669eec9fdbe3066b97422" cid="OP001" name="test_sensor_instantiation_and_inheritance" creation-date="10/09/2026 22:07:56" type="" type-id="" visibility="public">
                  <tagged-values>
                    <tagged-value id="tvfc04c7e5d98b42799e4086422435a75e" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_sensor_instantiation_and_inheritance" />
                    <tagged-value id="tve686fd37bf2942ec99cbfe3b9ae9af96" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_sensors.py" />
                    <tagged-value id="tv6a90eafcf0d44ee5946e2d824a9d9922" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tv56b748306ed144aaaaa18b1adb453040" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="613" />
                    <tagged-value id="tv39e8de41874c44758472a90ea7759792" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="713" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                                                                    
    temp_s = TemperatureSensor(id="t1", name="Temp 1")
    assert temp_s.id == "t1"
    assert temp_s.name == "Temp 1"
    assert temp_s.unit == "C"
    assert temp_s.status == SensorStatus.ONLINE
    assert temp_s.is_online() is True

    co2_s = CO2Sensor(id="c1", name="CO2 1")
    assert co2_s.unit == "ppm"

    hum_s = HumiditySensor(id="h1", name="Hum 1")
    assert hum_s.unit == "%"

    mot_s = MotionSensor(id="m1", name="Motion 1")
    assert mot_s.unit == "motion"

    eng_s = EnergySensor(id="e1", name="Energy 1")
    assert eng_s.unit == "kWh"


</source-code>
                  </source-codes>
                </operation>
                <operation id="o965396908b7947a2bd61cb1aab9650ca425" cid="OP002" name="test_sensor_state_transitions" creation-date="10/09/2026 22:07:56" type="" type-id="" visibility="public">
                  <tagged-values>
                    <tagged-value id="tv59f867fa1ff54ebfa2888f06dc79662a" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_sensor_state_transitions" />
                    <tagged-value id="tvfcd0e58e3351487897be8de8b5401105" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_sensors.py" />
                    <tagged-value id="tvd2d9ad0293654d6b86a8477626421cb9" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tv96b15f35b2774e119707b19b2c6b0131" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="1326" />
                    <tagged-value id="tvd26bf67830744d9fa9cd483b12f165b7" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="475" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                       
    sensor = TemperatureSensor(id="t1", name="Temp 1")
    assert sensor.is_online() is True

    sensor.disable()
    assert sensor.enabled is False
    assert sensor.status == SensorStatus.DISABLED
    assert sensor.is_online() is False

    sensor.enable()
    assert sensor.enabled is True
    assert sensor.status == SensorStatus.ONLINE
    assert sensor.is_online() is True


</source-code>
                  </source-codes>
                </operation>
                <operation id="o409b3898685149638397ed407184b966425" cid="OP003" name="test_room_and_sensor_association" creation-date="10/09/2026 22:07:56" type="" type-id="" visibility="public">
                  <tagged-values>
                    <tagged-value id="tv04d64e2b29f34fb2934d9a02b897aaa6" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_room_and_sensor_association" />
                    <tagged-value id="tvde931173376c4063a166d55e5cbb29a5" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_sensors.py" />
                    <tagged-value id="tv41c50afe5f004923a3c6f95264919d64" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tvdd33caa09dec48e78494f632d8c93065" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="1801" />
                    <tagged-value id="tv48191283153f4ff0ada93eddbaa95f95" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="577" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                                                
    room = Room(id="rm-101", name="Lab A", floor_number=1)
    sensor = TemperatureSensor(id="t1", name="Lab Temp")

    assert sensor.room_id is None
    room.add_sensor(sensor)

    assert sensor in room.sensors
    assert sensor.room_id == "rm-101"
    assert room.get_sensor("t1") == sensor

                   
    removed = room.remove_sensor("t1")
    assert removed is True
    assert sensor.room_id is None
    assert sensor not in room.sensors


</source-code>
                  </source-codes>
                </operation>
                <operation id="ob7f15302ea7c4d5d9764e4675f1936bd425" cid="OP004" name="test_building_floor_room_hierarchy" creation-date="10/09/2026 22:07:56" type="" type-id="" visibility="public">
                  <tagged-values>
                    <tagged-value id="tvbc515a8093524d66978fb3970ec7770a" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_building_floor_room_hierarchy" />
                    <tagged-value id="tv609e228024c745eb836ae98cdd907ab9" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_sensors.py" />
                    <tagged-value id="tv757fe1758f9b417199e7978afc7c6ccd" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tved8b8bb6173b4daa8f4c4b2e05dc51a8" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="2378" />
                    <tagged-value id="tv45fcdcd5a03842779ecde38bc0b19976" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="807" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                           
    bldg = Building(id="b1", name="Tower A", address="123 Tech St")
    fl1 = Floor(id="f1", number=1)
    rm1 = Room(id="r1", name="Server Room", floor_number=1)
    s1 = TemperatureSensor(id="s1", name="Rack Temp")
    s2 = HumiditySensor(id="s2", name="Rack Humidity")

    rm1.add_sensor(s1)
    rm1.add_sensor(s2)
    fl1.add_room(rm1)
    bldg.add_floor(fl1)

    assert fl1.building_id == "b1"
    assert rm1.floor_number == 1
    assert len(bldg.get_all_sensors()) == 2
    assert s1 in bldg.get_all_sensors()
    assert s2 in bldg.get_all_sensors()

                    
    assert fl1.remove_room("r1") is True
    assert fl1.get_room("r1") is None
    assert len(bldg.get_all_sensors()) == 0


</source-code>
                  </source-codes>
                </operation>
                <operation id="o4ddfade8aa4e4e9497717c9d735a478b425" cid="OP005" name="test_sensor_create_reading" creation-date="10/09/2026 22:07:56" type="" type-id="" visibility="public">
                  <tagged-values>
                    <tagged-value id="tvc4cd5b5643874b709c1db1c8a211f7b7" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_sensor_create_reading" />
                    <tagged-value id="tv92b67b1061424258b3f9f35f3765e42e" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_sensors.py" />
                    <tagged-value id="tvdc57bb9af18e4fa5ab77783dd9e38cb5" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tv5a633987d2df42919fac90e3fc3cba0f" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="3185" />
                    <tagged-value id="tv06c7d1819bec4e6a9c3db98a249a81ba" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="478" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                           
    sensor = TemperatureSensor(id="t1", name="Temp Sensor")
    sensor.set_simulated_value(22.5)

    reading = sensor.create_reading(reading_id="rd-01")
    assert isinstance(reading, SensorReading)
    assert reading.id == "rd-01"
    assert reading.sensor_id == "t1"
    assert reading.value == 22.5
    assert reading.unit == "C"
    assert sensor.last_reading_time is not None


</source-code>
                  </source-codes>
                </operation>
                <operation id="o202d4cd4942b43f6953482feaa6d4e9e425" cid="OP006" name="test_sensor_create_reading_offline_error" creation-date="10/09/2026 22:07:56" type="" type-id="" visibility="public">
                  <tagged-values>
                    <tagged-value id="tv933baa57ade14a57a4c010af9869ec19" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_sensor_create_reading_offline_error" />
                    <tagged-value id="tvc08d09b7b5bc4071a013526b8e7030d6" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_sensors.py" />
