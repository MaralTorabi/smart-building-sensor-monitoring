                <operation id="of79c7dfafc0545e5aee6f08e5118a705243" cid="OP017" name="test_detect_offline_sensor" creation-date="10/09/2026 22:14:52" type="" type-id="" visibility="public">
                  <parameters>
                    <parameter id="p89d37588b9384b53b9b8572ca6978f53" name="test_setup" type="" type-id="" creation-date="10/09/2026 22:14:52" />
                  </parameters>
                  <tagged-values>
                    <tagged-value id="tv6846ea0b82e54d8c8ce183bf99a153d8" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_detect_offline_sensor" />
                    <tagged-value id="tv0da1685037d5429595764fc4af46509d" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_monitoring.py" />
                    <tagged-value id="tvf78afed4eb3f4a208eb573d3d3fa048a" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tv8dbf32be614e4dafb45f2978205b977d" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="5049" />
                    <tagged-value id="tv0143dfe3edb74f29bc11499e7ad16210" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="904" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                                                 
    sensor_repo = test_setup["sensor_repo"]
    monitoring_svc = test_setup["monitoring_svc"]

                                      
    s1 = TemperatureSensor(id="s1", name="Active Sensor")
    s1.last_reading_time = datetime.now()
    sensor_repo.add(s1)

                                                         
    s2 = TemperatureSensor(id="s2", name="Dead Sensor")
    s2.last_reading_time = datetime.now() - timedelta(minutes=10)
    sensor_repo.add(s2)

    alerts = monitoring_svc.detect_offline_sensor(timeout_seconds=300.0)
    assert len(alerts) == 1
    assert alerts[0].sensor_id == "s2"
    assert alerts[0].severity == AlertSeverity.CRITICAL

                                            
    assert sensor_repo.get_by_id("s2").status == SensorStatus.OFFLINE


</source-code>
                  </source-codes>
                </operation>
                <operation id="o3e55efc6b11841a2b6083388f077a31e243" cid="OP018" name="test_reporting_service_aggregations" creation-date="10/09/2026 22:14:52" type="" type-id="" visibility="public">
                  <parameters>
                    <parameter id="p5b1459307dd1404c815db93e61655592" name="test_setup" type="" type-id="" creation-date="10/09/2026 22:14:52" />
                  </parameters>
                  <tagged-values>
                    <tagged-value id="tv3267b492eac44d36ad09141cbd4cad19" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_reporting_service_aggregations" />
                    <tagged-value id="tv2a3e6d2f46c14237ac91eb77b8635ea3" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_monitoring.py" />
                    <tagged-value id="tv441ac3a7b57c4930b555f2f750439716" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tv42302cc6c57845368018eec2abf96a8c" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="5953" />
                    <tagged-value id="tv435fe615c7cb456099c5aaecba84a15a" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="1384" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                                          
    sensor_repo = test_setup["sensor_repo"]
    reading_repo = test_setup["reading_repo"]
    reporting_svc = test_setup["reporting_svc"]

    sensor = TemperatureSensor(id="s_stat", name="Stat Temp Sensor")
    sensor_repo.add(sensor)

    reading_repo.add(SensorReading("r1", "s_stat", datetime.now(), 20.0, "C"))
    reading_repo.add(SensorReading("r2", "s_stat", datetime.now(), 30.0, "C"))
    reading_repo.add(SensorReading("r3", "s_stat", datetime.now(), 25.0, "C"))

    assert reporting_svc.calculate_min_reading("s_stat") == 20.0
    assert reporting_svc.calculate_max_reading("s_stat") == 30.0
    assert reporting_svc.calculate_average_reading("s_stat") == 25.0

                   
    sensor_rep = reporting_svc.generate_sensor_report("s_stat")
    assert sensor_rep["sensor_id"] == "s_stat"
    assert sensor_rep["total_readings"] == 3

                     
    bldg = Building("b1", "Alpha Center", "10 Innovation Blvd")
    fl = Floor("f1", 1)
    rm = Room("r1", "Main Hall", 1)
    rm.add_sensor(sensor)
    fl.add_room(rm)
    bldg.add_floor(fl)

    bldg_rep = reporting_svc.generate_building_report(bldg)
    assert bldg_rep["building_id"] == "b1"
    assert bldg_rep["total_sensors"] == 1
    assert bldg_rep["online_sensors"] == 1
</source-code>
                  </source-codes>
                </operation>
              </operations>
            </item>
