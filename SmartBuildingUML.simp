                <tagged-value id="tv2c46eafe5ca84d83a3510c90e8d7b895" name="SourceCodeFileSize" type="text" multiple="false" hidden="true" value="7435" />
                <tagged-value id="tvea29e72ad43747f4a51634671ceed77a" name="SourceCodeFileChangeDate" type="text" multiple="false" hidden="true" value="10/09/2026 17:42:14" />
              </tagged-values>
              <documentations>
                <doc id="012cd17ae7c346bb965e6721f8b2568a">
                  <text>
                    <default>
                      <style font-name="Verdana" font-size="12">
                        <text>
                          <solid-brush color="#FF000000" />
                        </text>
                      </style>
                    </default>
                    <styles />
                    <content>
                      <paragraph>
                        <style />
                        <p>
                          <t>""Identifies sensors that have not produced a reading within the configured timeout.
</t>
                        </p>
                      </paragraph>
                      <paragraph>
                        <style />
                        <p>
                          <t>        Transitions unresponsive online sensors to OFFLINE and raises CRITICAL alerts.
</t>
                        </p>
                      </paragraph>
                      <paragraph>
                        <style />
                        <p>
                          <t>        Args:
</t>
                        </p>
                      </paragraph>
                      <paragraph>
                        <style />
                        <p>
                          <t>            timeout_seconds: Duration in seconds beyond which a sensor is deemed offline.
</t>
                        </p>
                      </paragraph>
                      <paragraph>
                        <style />
                        <p>
                          <t>        Returns:
</t>
                        </p>
                      </paragraph>
                      <paragraph>
                        <style />
                        <p>
                          <t>            List of generated offline alerts.
</t>
                        </p>
                      </paragraph>
                      <paragraph>
                        <style />
                        <p>
                          <t>        """
</t>
                        </p>
                      </paragraph>
                    </content>
                  </text>
                </doc>
              </documentations>
              <feature static="true" />
            </item>
