            <operation id="o2ed0237b600143e3a5fba586642297a5585" cid="OP007" name="test_reading_validation_and_unit_conversion" creation-date="10/09/2026 22:14:36" type="" type-id="" visibility="public">
              <tagged-values>
                <tagged-value id="tvc95e59613ecf4446b70d72402bc80c6c" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_reading_validation_and_unit_conversion" />
                <tagged-value id="tv1465e6bd2ae34e0d8d36e8e91c106226" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_sensors.py" />
                <tagged-value id="tvd1860f73ca554ff2a3bd167b2a60f09e" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                <tagged-value id="tv0f0472bb614344f3b9055784d737f71d" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="3955" />
                <tagged-value id="tv4ae35aed42b44fc0adedbc48dabda7bb" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="933" />
              </tagged-values>
              <source-codes>
                <source-code language="Python">                                                                  
    valid_reading = SensorReading("r1", "t1", datetime.now(), 25.0, "C")
    assert valid_reading.is_valid() is True

                                                   
    f_val = valid_reading.convert_unit("F")
    assert round(f_val, 2) == 77.0

                                             
    k_val = valid_reading.convert_unit("K")
    assert round(k_val, 2) == 298.15

                               
    power_reading = SensorReading("r2", "e1", datetime.now(), 5.0, "kW")
    w_val = power_reading.convert_unit("W")
    assert w_val == 5000.0

                           
    nan_reading = SensorReading("r3", "t1", datetime.now(), float("nan"), "C")
    assert nan_reading.is_valid() is False

                            
    with pytest.raises(ValueError):
        valid_reading.convert_unit("meter")
</source-code>
              </source-codes>
            </operation>
            <operation id="o4b2eb8fa563a4c478be30de8e4faf3b8586" cid="OP008" name="test_in_memory_repository_crud" creation-date="10/09/2026 22:14:36" type="" type-id="" visibility="public">
              <tagged-values>
                <tagged-value id="tve70a9d186bcc45a09ab882eee5fdf59d" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_in_memory_repository_crud" />
                <tagged-value id="tvac326b9f029f4dcc98b39f7533ec65b8" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_repositories.py" />
                <tagged-value id="tvf726d805123143e9a3f1ce9c400878e9" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                <tagged-value id="tv8e145c8e33d5416193bc2ee3b0e01cf1" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="585" />
                <tagged-value id="tv0ab6f4248a9849c695267c862d9bca88" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="982" />
              </tagged-values>
              <source-codes>
                <source-code language="Python">                                                             
    repo = InMemoryRepository[TemperatureSensor]()
    sensor1 = TemperatureSensor(id="s1", name="Sensor One")
    sensor2 = TemperatureSensor(id="s2", name="Sensor Two")

         
    repo.add(sensor1)
    repo.add(sensor2)
    assert repo.count() == 2

               
    fetched = repo.get_by_id("s1")
    assert fetched == sensor1
    assert repo.get_by_id("non-existent") is None

             
    all_sensors = repo.get_all()
    assert len(all_sensors) == 2
    assert sensor1 in all_sensors

            
    sensor1.name = "Sensor One Renamed"
    updated = repo.update(sensor1)
    assert updated is True
    assert repo.get_by_id("s1").name == "Sensor One Renamed"

            
    deleted = repo.delete("s1")
    assert deleted is True
    assert repo.get_by_id("s1") is None
    assert repo.count() == 1

           
    repo.clear()
    assert repo.count() == 0


</source-code>
              </source-codes>
            </operation>
            <operation id="of22c51ab5105454b9dca1536bd17c68b586" cid="OP009" name="test_sensor_repository_queries" creation-date="10/09/2026 22:14:36" type="" type-id="" visibility="public">
              <tagged-values>
                <tagged-value id="tvd68e2ecf485448c6bda1039882968bac" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_sensor_repository_queries" />
                <tagged-value id="tvdefd4602f006433697799bd70611ba57" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_repositories.py" />
                <tagged-value id="tv94c95da7307844a5ae619cffb04743b5" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                <tagged-value id="tv5ae0ff9b9d9142bd8862b73d86d02fb2" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="1567" />
                <tagged-value id="tvf3abf41df4944e679b47802768c9f774" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="856" />
              </tagged-values>
              <source-codes>
                <source-code language="Python">                                                          
    repo = SensorRepository()
    s1 = TemperatureSensor(id="s1", name="Room A Temp", room_id="rm-A")
    s2 = TemperatureSensor(id="s2", name="Room B Temp", room_id="rm-B")
    s3 = TemperatureSensor(id="s3", name="Room A Backup", room_id="rm-A")
    s3.status = SensorStatus.OFFLINE

    repo.add(s1)
    repo.add(s2)
    repo.add(s3)

                    
    room_a_sensors = repo.get_by_room_id("rm-A")
    assert len(room_a_sensors) == 2
    assert s1 in room_a_sensors
    assert s3 in room_a_sensors

                   
    offline_sensors = repo.get_by_status(SensorStatus.OFFLINE)
    assert len(offline_sensors) == 1
    assert offline_sensors[0] == s3

                                            
    assert repo.get_offline_sensors() == [s3]


</source-code>
              </source-codes>
            </operation>
            <operation id="o8594fc3ff19e4f8fb52d3625d277c59b586" cid="OP010" name="test_reading_repository_queries" creation-date="10/09/2026 22:14:36" type="" type-id="" visibility="public">
              <tagged-values>
                <tagged-value id="tve7c4263b8890437992583cde553fb021" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_reading_repository_queries" />
                <tagged-value id="tv0fee3ed9f44e493098e83a458f11e0b1" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_repositories.py" />
                <tagged-value id="tv5214adbab3344198850865d8bccde666" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                <tagged-value id="tvf45a51edd34b4a0e9f60da663f6595e2" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="2423" />
                <tagged-value id="tv0f4c4510392d440d915816b655484017" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="1122" />
              </tagged-values>
              <source-codes>
                <source-code language="Python">                                                           
    repo = ReadingRepository()
    t0 = datetime.now() - timedelta(minutes=10)
    t1 = datetime.now() - timedelta(minutes=5)
    t2 = datetime.now()

    r1 = SensorReading(id="r1", sensor_id="s1", timestamp=t0, value=20.0, unit="C")
    r2 = SensorReading(id="r2", sensor_id="s1", timestamp=t1, value=22.0, unit="C")
    r3 = SensorReading(id="r3", sensor_id="s1", timestamp=t2, value=25.0, unit="C")
    r4 = SensorReading(id="r4", sensor_id="s2", timestamp=t2, value=50.0, unit="%")

    repo.add(r1)
    repo.add(r2)
    repo.add(r3)
    repo.add(r4)

                      
    s1_readings = repo.get_by_sensor_id("s1")
    assert len(s1_readings) == 3

                        
    latest_s1 = repo.get_latest_reading("s1")
    assert latest_s1 is not None
    assert latest_s1.id == "r3"
    assert latest_s1.value == 25.0

                        
    recent = repo.get_readings_since("s1", since=datetime.now() - timedelta(minutes=7))
    assert len(recent) == 2
    assert r2 in recent
    assert r3 in recent


</source-code>
              </source-codes>
            </operation>
            <operation id="oa8e7e694338543aabf89a6d8c3d9a672586" cid="OP011" name="test_alert_repository_queries" creation-date="10/09/2026 22:14:36" type="" type-id="" visibility="public">
              <tagged-values>
                <tagged-value id="tv807b1004ca8047e7b4327370c439ec1b" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_alert_repository_queries" />
                <tagged-value id="tvba5b6613552943a7b76c461ffb2ca170" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_repositories.py" />
                <tagged-value id="tv8bb2a6d16425499694f440dbcf49d8ba" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                <tagged-value id="tvdaf793577aa047dfbe3079d5b762e5bc" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="3545" />
                <tagged-value id="tv1e8f53211ede49fb8fe9d2312ad8e675" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="810" />
              </tagged-values>
              <source-codes>
                <source-code language="Python">                                                  
    repo = AlertRepository()
    a1 = Alert(id="a1", sensor_id="s1", message="Warning 1", severity=AlertSeverity.WARNING, status=AlertStatus.OPEN)
    a2 = Alert(id="a2", sensor_id="s1", message="Critical 1", severity=AlertSeverity.CRITICAL, status=AlertStatus.OPEN)
    a3 = Alert(id="a3", sensor_id="s2", message="Info 1", severity=AlertSeverity.INFO, status=AlertStatus.RESOLVED)

    repo.add(a1)
    repo.add(a2)
    repo.add(a3)

    assert len(repo.get_by_sensor_id("s1")) == 2
    assert len(repo.get_open_alerts()) == 2
    assert len(repo.get_by_severity(AlertSeverity.CRITICAL)) == 1
    assert repo.get_by_severity(AlertSeverity.CRITICAL)[0] == a2
    assert len(repo.get_by_status(AlertStatus.RESOLVED)) == 1
</source-code>
              </source-codes>
            </operation>
            <operation id="oebdb254705cd43f4b26d78836337207a586" cid="OP012" name="test_setup" creation-date="10/09/2026 22:14:36" type="" type-id="" visibility="public">
              <tagged-values>
                <tagged-value id="tv5505a3afbff8431699b9f0e43acfb55f" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_setup" />
                <tagged-value id="tv76bc7774c4634b41912b082f18fa0ced" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_monitoring.py" />
                <tagged-value id="tv9dd2acc9613944b2875ac499bbd84f60" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                <tagged-value id="tvf1ec9664fc284c38b5b5f62277efc786" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="916" />
                <tagged-value id="tv7f8895bc44aa4b75bb55b925526b246f" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="1033" />
              </tagged-values>
              <source-codes>
                <source-code language="Python">                                                              
    sensor_repo = SensorRepository()
    reading_repo = ReadingRepository()
    alert_repo = AlertRepository()
    notification_svc = ConsoleNotificationService()
    alert_svc = AlertService(
        alert_repository=alert_repo,
        notification_service=notification_svc,
        notification_recipient="test-admin@building.local",
    )
    monitoring_svc = MonitoringService(
        sensor_repository=sensor_repo,
        reading_repository=reading_repo,
        alert_service=alert_svc,
    )
    reporting_svc = ReportingService(
        sensor_repository=sensor_repo,
        reading_repository=reading_repo,
        alert_repository=alert_repo,
    )
    return {
        "sensor_repo": sensor_repo,
        "reading_repo": reading_repo,
        "alert_repo": alert_repo,
        "notification_svc": notification_svc,
        "alert_svc": alert_svc,
        "monitoring_svc": monitoring_svc,
        "reporting_svc": reporting_svc,
    }


</source-code>
              </source-codes>
            </operation>
