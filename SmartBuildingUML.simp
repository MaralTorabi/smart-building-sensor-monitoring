                <tagged-value id="tv393f20c40b1b4b43b2d4fbaba71455fe" name="SourceCodeFileSize" type="text" multiple="false" hidden="true" value="3896" />
                <tagged-value id="tv52639b5961264a3b875bc13ed2e3ab39" name="SourceCodeFileChangeDate" type="text" multiple="false" hidden="true" value="10/09/2026 17:42:02" />
              </tagged-values>
              <documentations>
                <doc id="00693fb823824a8d8bff23b6b04c0924">
                  <text>
                    <default>
                      <style font-name="Verdana" font-size="12">
                        <text>
                          <solid-brush color="#FF000000" />
                        </text>
                      </style>
                    </default>
                    <styles />
                    <content>
                      <paragraph>
                        <style />
                        <p>
                          <t>"""Creates, stores, and optionally announces a new system alert.
</t>
                        </p>
                      </paragraph>
                      <paragraph>
                        <style />
                        <p>
                          <t>        Args:
</t>
                        </p>
                      </paragraph>
                      <paragraph>
                        <style />
                        <p>
                          <t>            sensor_id: Target sensor identifier.
</t>
                        </p>
                      </paragraph>
                      <paragraph>
                        <style />
                        <p>
                          <t>            message: Explanation of the alert condition.
</t>
                        </p>
                      </paragraph>
                      <paragraph>
                        <style />
                        <p>
                          <t>            severity: Severity level (INFO, WARNING, CRITICAL).
</t>
                        </p>
                      </paragraph>
                      <paragraph>
                        <style />
                        <p>
                          <t>            reading_id: Associated reading identifier.
</t>
                        </p>
                      </paragraph>
                      <paragraph>
                        <style />
                        <p>
                          <t>        Returns:
</t>
                        </p>
                      </paragraph>
                      <paragraph>
                        <style />
                        <p>
                          <t>            The created Alert instance.
</t>
                        </p>
                      </paragraph>
                      <paragraph>
                        <style />
                        <p>
                          <t>        """
</t>
                        </p>
                      </paragraph>
                    </content>
                  </text>
                </doc>
              </documentations>
              <feature static="true" />
            </item>
