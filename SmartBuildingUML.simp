            <operation id="o88b9705f927f40528459663dcfee5c71976" cid="OP012" name="test_setup" creation-date="10/09/2026 22:15:14" type="" type-id="" visibility="public">
              <tagged-values>
                <tagged-value id="tv64bc6a219007425297c37275ed33d39e" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_setup" />
                <tagged-value id="tv618fc6541f844f1cab04386b20a5468d" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_monitoring.py" />
                <tagged-value id="tv35d0fc3fd55b40389543d44576b82192" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                <tagged-value id="tv107cc69c5ba54209833810d5d940cdca" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="916" />
                <tagged-value id="tv0327bb59b81b432eb18b3b24f6877eda" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="1033" />
              </tagged-values>
              <source-codes>
                <source-code language="Python">                                                              
    sensor_repo = SensorRepository()
    reading_repo = ReadingRepository()
    alert_repo = AlertRepository()
    notification_svc = ConsoleNotificationService()
    alert_svc = AlertService(
        alert_repository=alert_repo,
        notification_service=notification_svc,
        notification_recipient="test-admin@building.local",
    )
    monitoring_svc = MonitoringService(
        sensor_repository=sensor_repo,
        reading_repository=reading_repo,
        alert_service=alert_svc,
    )
    reporting_svc = ReportingService(
        sensor_repository=sensor_repo,
        reading_repository=reading_repo,
        alert_repository=alert_repo,
    )
    return {
        "sensor_repo": sensor_repo,
        "reading_repo": reading_repo,
        "alert_repo": alert_repo,
        "notification_svc": notification_svc,
        "alert_svc": alert_svc,
        "monitoring_svc": monitoring_svc,
        "reporting_svc": reporting_svc,
    }


</source-code>
              </source-codes>
            </operation>
