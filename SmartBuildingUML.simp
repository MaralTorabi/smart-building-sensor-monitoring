                <operation id="o1aa26aa643c245ff9ad945bcd7bdb658426" cid="OP010" name="test_reading_repository_queries" creation-date="10/09/2026 22:07:56" type="" type-id="" visibility="public">
                  <tagged-values>
                    <tagged-value id="tvf89df0d6134e41cf8f0c0cf7bff2f138" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_reading_repository_queries" />
                    <tagged-value id="tv39ba8ea130ae4098ab82bbca6a71def8" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_repositories.py" />
                    <tagged-value id="tve86e488cd44c4411b2ed1f661e5fa282" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tv9c11bc5578634d35a9e392b00be9b2e8" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="2423" />
                    <tagged-value id="tv8684da57fcf449f4b553979936fea72f" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="1122" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                           
    repo = ReadingRepository()
    t0 = datetime.now() - timedelta(minutes=10)
    t1 = datetime.now() - timedelta(minutes=5)
    t2 = datetime.now()

    r1 = SensorReading(id="r1", sensor_id="s1", timestamp=t0, value=20.0, unit="C")
    r2 = SensorReading(id="r2", sensor_id="s1", timestamp=t1, value=22.0, unit="C")
    r3 = SensorReading(id="r3", sensor_id="s1", timestamp=t2, value=25.0, unit="C")
    r4 = SensorReading(id="r4", sensor_id="s2", timestamp=t2, value=50.0, unit="%")

    repo.add(r1)
    repo.add(r2)
    repo.add(r3)
    repo.add(r4)

                      
    s1_readings = repo.get_by_sensor_id("s1")
    assert len(s1_readings) == 3

                        
    latest_s1 = repo.get_latest_reading("s1")
    assert latest_s1 is not None
    assert latest_s1.id == "r3"
    assert latest_s1.value == 25.0

                        
    recent = repo.get_readings_since("s1", since=datetime.now() - timedelta(minutes=7))
    assert len(recent) == 2
    assert r2 in recent
    assert r3 in recent


</source-code>
                  </source-codes>
                </operation>
                <operation id="oef76c33b2d68467283cde02e98c0774b426" cid="OP011" name="test_alert_repository_queries" creation-date="10/09/2026 22:07:56" type="" type-id="" visibility="public">
                  <tagged-values>
                    <tagged-value id="tv1baa59304ab9462ba1aebd4d8b3a46f1" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_alert_repository_queries" />
                    <tagged-value id="tvf1f2d05c7d534ed4aa13a30c82d51f22" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_repositories.py" />
                    <tagged-value id="tv73df44a51d7a4bd58ac4b233cf2c5ed0" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tv832b964f42ee41b0808a9fe8db7d3918" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="3545" />
                    <tagged-value id="tvce1068850db14653aa2b0acaef6b12f4" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="810" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                  
    repo = AlertRepository()
    a1 = Alert(id="a1", sensor_id="s1", message="Warning 1", severity=AlertSeverity.WARNING, status=AlertStatus.OPEN)
    a2 = Alert(id="a2", sensor_id="s1", message="Critical 1", severity=AlertSeverity.CRITICAL, status=AlertStatus.OPEN)
    a3 = Alert(id="a3", sensor_id="s2", message="Info 1", severity=AlertSeverity.INFO, status=AlertStatus.RESOLVED)

    repo.add(a1)
    repo.add(a2)
    repo.add(a3)

    assert len(repo.get_by_sensor_id("s1")) == 2
    assert len(repo.get_open_alerts()) == 2
    assert len(repo.get_by_severity(AlertSeverity.CRITICAL)) == 1
    assert repo.get_by_severity(AlertSeverity.CRITICAL)[0] == a2
    assert len(repo.get_by_status(AlertStatus.RESOLVED)) == 1
</source-code>
                  </source-codes>
