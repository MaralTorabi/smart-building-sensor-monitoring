            <operation id="oe9168ecc80c148d0b122950badd8a01a976" cid="OP010" name="test_reading_repository_queries" creation-date="10/09/2026 22:15:14" type="" type-id="" visibility="public">
              <tagged-values>
                <tagged-value id="tv5aa7960229254d49b55719727f0644ac" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_reading_repository_queries" />
                <tagged-value id="tv0afe9cfc640141de87de6b53ae7c9f73" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_repositories.py" />
                <tagged-value id="tv79bfa3b8231b4a98bbae7985502c19a4" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                <tagged-value id="tv4d32c75a6b4c400a8a5dc8909c6cdcdb" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="2423" />
                <tagged-value id="tv0ed8276222014fae8df6ea0ca1c73838" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="1122" />
              </tagged-values>
              <source-codes>
                <source-code language="Python">                                                           
    repo = ReadingRepository()
    t0 = datetime.now() - timedelta(minutes=10)
    t1 = datetime.now() - timedelta(minutes=5)
    t2 = datetime.now()

    r1 = SensorReading(id="r1", sensor_id="s1", timestamp=t0, value=20.0, unit="C")
    r2 = SensorReading(id="r2", sensor_id="s1", timestamp=t1, value=22.0, unit="C")
    r3 = SensorReading(id="r3", sensor_id="s1", timestamp=t2, value=25.0, unit="C")
    r4 = SensorReading(id="r4", sensor_id="s2", timestamp=t2, value=50.0, unit="%")

    repo.add(r1)
    repo.add(r2)
    repo.add(r3)
    repo.add(r4)

                      
    s1_readings = repo.get_by_sensor_id("s1")
    assert len(s1_readings) == 3

                        
    latest_s1 = repo.get_latest_reading("s1")
    assert latest_s1 is not None
    assert latest_s1.id == "r3"
    assert latest_s1.value == 25.0

                        
    recent = repo.get_readings_since("s1", since=datetime.now() - timedelta(minutes=7))
    assert len(recent) == 2
    assert r2 in recent
    assert r3 in recent


</source-code>
              </source-codes>
            </operation>
            <operation id="o0f5f694e590241798a014de55506d6e5976" cid="OP011" name="test_alert_repository_queries" creation-date="10/09/2026 22:15:14" type="" type-id="" visibility="public">
              <tagged-values>
                <tagged-value id="tv4bc9cc6d891943a39e697a9a2c12914b" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_alert_repository_queries" />
                <tagged-value id="tvf3d3ede2a9c746799a1323395b0c3b6d" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_repositories.py" />
                <tagged-value id="tv6a09bd4a13fd4f42af94dc976b19d912" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                <tagged-value id="tv2085ef29e46949d5848228651e417a38" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="3545" />
                <tagged-value id="tv156699caf4d6439ba35f6a676f92eea5" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="810" />
              </tagged-values>
              <source-codes>
                <source-code language="Python">                                                  
    repo = AlertRepository()
    a1 = Alert(id="a1", sensor_id="s1", message="Warning 1", severity=AlertSeverity.WARNING, status=AlertStatus.OPEN)
    a2 = Alert(id="a2", sensor_id="s1", message="Critical 1", severity=AlertSeverity.CRITICAL, status=AlertStatus.OPEN)
    a3 = Alert(id="a3", sensor_id="s2", message="Info 1", severity=AlertSeverity.INFO, status=AlertStatus.RESOLVED)

    repo.add(a1)
    repo.add(a2)
    repo.add(a3)

    assert len(repo.get_by_sensor_id("s1")) == 2
    assert len(repo.get_open_alerts()) == 2
    assert len(repo.get_by_severity(AlertSeverity.CRITICAL)) == 1
    assert repo.get_by_severity(AlertSeverity.CRITICAL)[0] == a2
    assert len(repo.get_by_status(AlertStatus.RESOLVED)) == 1
</source-code>
