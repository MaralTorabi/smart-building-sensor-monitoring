              </parameters>
              <tagged-values>
                <tagged-value id="tv3e69604763214142ba657464847947e8" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_monitoring_threshold_warning_and_critical" />
                <tagged-value id="tv01fceaaa9678481197b95108bacbae6e" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_monitoring.py" />
                <tagged-value id="tv23eeffe2c41c4804a4def8285dc3f8be" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                <tagged-value id="tvfb440e5330f443f1a2ea50e7081e90ef" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="2434" />
                <tagged-value id="tvf5ff79bc52894fdbb8099b5cf97002ba" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="977" />
              </tagged-values>
              <source-codes>
                <source-code language="Python">                                                                             
    sensor = TemperatureSensor(id="s1", name="Temp Sensor")
    test_setup["sensor_repo"].add(sensor)

                                              
    reading_warn = SensorReading("r_warn", "s1", datetime.now(), 27.5, "C")
    alert_warn = test_setup["monitoring_svc"].process_reading(reading_warn)
    assert alert_warn is not None
    assert alert_warn.severity == AlertSeverity.WARNING
    assert alert_warn.status == AlertStatus.OPEN

                                               
    reading_crit = SensorReading("r_crit", "s1", datetime.now(), 38.0, "C")
    alert_crit = test_setup["monitoring_svc"].process_reading(reading_crit)
    assert alert_crit is not None
    assert alert_crit.severity == AlertSeverity.CRITICAL

                                                 
    assert test_setup["alert_repo"].count() == 2


