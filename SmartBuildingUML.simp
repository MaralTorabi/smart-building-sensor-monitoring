                <tagged-value id="tv3d2670622441403b9234971310b9946b" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\src\service\monitoring.py" />
