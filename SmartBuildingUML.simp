        <item id="1d5b1988a48a49f1927ea8f2e1229c93" cid="C028" type="class" creation-date="10/09/2026 22:15:14">
          <operations>
            <operation id="o965db16fba7a42e5a11ce5e3da10eefc975" cid="OP001" name="test_sensor_instantiation_and_inheritance" creation-date="10/09/2026 22:15:14" type="" type-id="" visibility="public">
              <tagged-values>
                <tagged-value id="tv0889741d6225465c9c56706caf48aa68" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_sensor_instantiation_and_inheritance" />
                <tagged-value id="tv8b8ae1a648074e368f1af1a45f82b75b" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_sensors.py" />
                <tagged-value id="tv08924762ee094536aa12c685315b1829" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                <tagged-value id="tv0cae5e995bb64b59820cc470ce27edd2" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="613" />
                <tagged-value id="tv1d107f149dcf462bb7fb7da74475ee1d" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="713" />
              </tagged-values>
              <source-codes>
                <source-code language="Python">                                                                                                    
    temp_s = TemperatureSensor(id="t1", name="Temp 1")
    assert temp_s.id == "t1"
    assert temp_s.name == "Temp 1"
    assert temp_s.unit == "C"
    assert temp_s.status == SensorStatus.ONLINE
    assert temp_s.is_online() is True

    co2_s = CO2Sensor(id="c1", name="CO2 1")
    assert co2_s.unit == "ppm"

    hum_s = HumiditySensor(id="h1", name="Hum 1")
    assert hum_s.unit == "%"

    mot_s = MotionSensor(id="m1", name="Motion 1")
    assert mot_s.unit == "motion"

    eng_s = EnergySensor(id="e1", name="Energy 1")
    assert eng_s.unit == "kWh"


</source-code>
              </source-codes>
            </operation>
            <operation id="o5e11344dfc224c9c85ec95b542528942975" cid="OP002" name="test_sensor_state_transitions" creation-date="10/09/2026 22:15:14" type="" type-id="" visibility="public">
              <tagged-values>
                <tagged-value id="tv553569409dde4259a0f6e26c7ec143d3" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_sensor_state_transitions" />
                <tagged-value id="tv45437ca3305d40b3ae0af6f6320f0260" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_sensors.py" />
                <tagged-value id="tv7ad0297f87e5412fa3f9f122dde4c15b" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                <tagged-value id="tvefe3f6286bf24e54ab27156a15701d8f" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="1326" />
                <tagged-value id="tv5e03dbd937f94ec5a45b12227d686b7f" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="475" />
              </tagged-values>
              <source-codes>
                <source-code language="Python">                                                       
    sensor = TemperatureSensor(id="t1", name="Temp 1")
    assert sensor.is_online() is True

    sensor.disable()
    assert sensor.enabled is False
    assert sensor.status == SensorStatus.DISABLED
    assert sensor.is_online() is False

    sensor.enable()
    assert sensor.enabled is True
    assert sensor.status == SensorStatus.ONLINE
    assert sensor.is_online() is True


</source-code>
              </source-codes>
            </operation>
            <operation id="o55ecd83fa8e34bd2b4080fef983bb8fb975" cid="OP003" name="test_room_and_sensor_association" creation-date="10/09/2026 22:15:14" type="" type-id="" visibility="public">
              <tagged-values>
                <tagged-value id="tvb7f4e98ab7574ac2a320b3d0f0646414" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_room_and_sensor_association" />
                <tagged-value id="tv76d05220f3094dd9b0c9bd50ddf6a0b5" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_sensors.py" />
                <tagged-value id="tv86e124a54155465094f67b5e9bae1f3c" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                <tagged-value id="tv3c2629f1d380485b9a1e6972d53dd536" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="1801" />
                <tagged-value id="tv0bf8202569634602ac8e74942e575acb" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="577" />
              </tagged-values>
              <source-codes>
                <source-code language="Python">                                                                                
    room = Room(id="rm-101", name="Lab A", floor_number=1)
    sensor = TemperatureSensor(id="t1", name="Lab Temp")

    assert sensor.room_id is None
    room.add_sensor(sensor)

    assert sensor in room.sensors
    assert sensor.room_id == "rm-101"
    assert room.get_sensor("t1") == sensor

                   
    removed = room.remove_sensor("t1")
    assert removed is True
    assert sensor.room_id is None
    assert sensor not in room.sensors


</source-code>
              </source-codes>
            </operation>
            <operation id="oa8478a0f02c04e3d8061f46fdac3b7bb976" cid="OP004" name="test_building_floor_room_hierarchy" creation-date="10/09/2026 22:15:14" type="" type-id="" visibility="public">
              <tagged-values>
                <tagged-value id="tvb23ca62efc7e448d9052561786a80cd7" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_building_floor_room_hierarchy" />
                <tagged-value id="tvaf956dfadc1c4922a117d36aba544ad3" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_sensors.py" />
                <tagged-value id="tv3851139e82ed4998991eb52894d8c205" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                <tagged-value id="tv4c82da7d4920441098478809605e1bc0" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="2378" />
                <tagged-value id="tv4265c0ea06b0490bbe6ce4c3ceaf6143" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="807" />
              </tagged-values>
              <source-codes>
                <source-code language="Python">                                                           
    bldg = Building(id="b1", name="Tower A", address="123 Tech St")
    fl1 = Floor(id="f1", number=1)
    rm1 = Room(id="r1", name="Server Room", floor_number=1)
    s1 = TemperatureSensor(id="s1", name="Rack Temp")
    s2 = HumiditySensor(id="s2", name="Rack Humidity")

    rm1.add_sensor(s1)
    rm1.add_sensor(s2)
    fl1.add_room(rm1)
    bldg.add_floor(fl1)

    assert fl1.building_id == "b1"
    assert rm1.floor_number == 1
    assert len(bldg.get_all_sensors()) == 2
    assert s1 in bldg.get_all_sensors()
    assert s2 in bldg.get_all_sensors()

                    
    assert fl1.remove_room("r1") is True
    assert fl1.get_room("r1") is None
    assert len(bldg.get_all_sensors()) == 0


</source-code>
