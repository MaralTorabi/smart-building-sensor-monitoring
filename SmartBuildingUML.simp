            <operation id="o12a3ae70a78d48a58597ca39f097a5ed976" cid="OP007" name="test_reading_validation_and_unit_conversion" creation-date="10/09/2026 22:15:14" type="" type-id="" visibility="public">
              <tagged-values>
                <tagged-value id="tv74b8d7cbc1cf4a6382fa8c4d7c0fa72e" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_reading_validation_and_unit_conversion" />
                <tagged-value id="tva937109be6574f2d86866c9a726d92ba" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_sensors.py" />
                <tagged-value id="tv99ba9ff5f15640c89d7f49a8e874fdbb" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                <tagged-value id="tv87304d25bae346ffb52d3f812e3ee8b5" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="3955" />
                <tagged-value id="tv9cd4a35d45254f959ecf2aa6a01597fc" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="933" />
              </tagged-values>
              <source-codes>
                <source-code language="Python">                                                                  
    valid_reading = SensorReading("r1", "t1", datetime.now(), 25.0, "C")
    assert valid_reading.is_valid() is True

                                                   
    f_val = valid_reading.convert_unit("F")
    assert round(f_val, 2) == 77.0

                                             
    k_val = valid_reading.convert_unit("K")
    assert round(k_val, 2) == 298.15

                               
    power_reading = SensorReading("r2", "e1", datetime.now(), 5.0, "kW")
    w_val = power_reading.convert_unit("W")
    assert w_val == 5000.0

                           
    nan_reading = SensorReading("r3", "t1", datetime.now(), float("nan"), "C")
    assert nan_reading.is_valid() is False

                            
    with pytest.raises(ValueError):
        valid_reading.convert_unit("meter")
</source-code>
