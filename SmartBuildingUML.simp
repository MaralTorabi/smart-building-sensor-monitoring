                <operation id="o09759e493a9040648671766fefd592e1426" cid="OP008" name="test_in_memory_repository_crud" creation-date="10/09/2026 22:07:56" type="" type-id="" visibility="public">
                  <tagged-values>
                    <tagged-value id="tv533beb7c74a04e648457919f05ce26be" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_in_memory_repository_crud" />
                    <tagged-value id="tvf2599050417140feb450eae9cbd85448" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_repositories.py" />
                    <tagged-value id="tv6b100aff199646df9ed584ec26eea7f5" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tv459b4e9c61a94b1998e91a2f0d451360" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="585" />
                    <tagged-value id="tvd9326b14161c4d9c8f8c6cbf9089bec3" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="982" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                             
    repo = InMemoryRepository[TemperatureSensor]()
    sensor1 = TemperatureSensor(id="s1", name="Sensor One")
    sensor2 = TemperatureSensor(id="s2", name="Sensor Two")

         
    repo.add(sensor1)
    repo.add(sensor2)
    assert repo.count() == 2

               
    fetched = repo.get_by_id("s1")
    assert fetched == sensor1
    assert repo.get_by_id("non-existent") is None

             
    all_sensors = repo.get_all()
    assert len(all_sensors) == 2
    assert sensor1 in all_sensors

            
    sensor1.name = "Sensor One Renamed"
    updated = repo.update(sensor1)
    assert updated is True
    assert repo.get_by_id("s1").name == "Sensor One Renamed"

            
    deleted = repo.delete("s1")
    assert deleted is True
    assert repo.get_by_id("s1") is None
    assert repo.count() == 1

           
    repo.clear()
    assert repo.count() == 0


</source-code>
                  </source-codes>
                </operation>
                <operation id="o5a3b202f898241aaad688bb0091b94d5426" cid="OP009" name="test_sensor_repository_queries" creation-date="10/09/2026 22:07:56" type="" type-id="" visibility="public">
                  <tagged-values>
                    <tagged-value id="tvfadac57e3548487fb75bc2b9b5b073eb" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_sensor_repository_queries" />
                    <tagged-value id="tvad7e228b42414e66b0d941da4448c31a" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_repositories.py" />
                    <tagged-value id="tv2e525074cba54286a334692645097b90" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tv695ff92612fa49b9bc36b8608c37c441" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="1567" />
                    <tagged-value id="tv571b68c622bd467bba627b6e7f741f5d" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="856" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                          
    repo = SensorRepository()
    s1 = TemperatureSensor(id="s1", name="Room A Temp", room_id="rm-A")
    s2 = TemperatureSensor(id="s2", name="Room B Temp", room_id="rm-B")
    s3 = TemperatureSensor(id="s3", name="Room A Backup", room_id="rm-A")
    s3.status = SensorStatus.OFFLINE

    repo.add(s1)
    repo.add(s2)
    repo.add(s3)

                    
    room_a_sensors = repo.get_by_room_id("rm-A")
    assert len(room_a_sensors) == 2
    assert s1 in room_a_sensors
    assert s3 in room_a_sensors

                   
    offline_sensors = repo.get_by_status(SensorStatus.OFFLINE)
    assert len(offline_sensors) == 1
    assert offline_sensors[0] == s3

                                            
    assert repo.get_offline_sensors() == [s3]


</source-code>
                  </source-codes>
