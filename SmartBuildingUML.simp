            <operation id="o368658d0af32431ebd8ecadf42810d3f586" cid="OP015" name="test_alert_lifecycle_workflow" creation-date="10/09/2026 22:14:36" type="" type-id="" visibility="public">
              <parameters>
                <parameter id="p05419ebe18cb4be88701a3cbb354d44a" name="test_setup" type="" type-id="" creation-date="10/09/2026 22:14:36" />
              </parameters>
              <tagged-values>
                <tagged-value id="tv781fd404c4cc4febab34b8332c3ad4ba" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_alert_lifecycle_workflow" />
                <tagged-value id="tve532834b3ab64ac4a83f60c714ce9b7c" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_monitoring.py" />
                <tagged-value id="tv7b7c05ffd3a344f08dd1007a09ade904" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                <tagged-value id="tv154797fc5bff4f278867f74d5c47e19c" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="3411" />
                <tagged-value id="tv7e01c53d88144b51ad7dee0c8b3a1579" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="912" />
              </tagged-values>
              <source-codes>
                <source-code language="Python">                                                               
    alert_svc = test_setup["alert_svc"]
    alert = alert_svc.create_alert(
        sensor_id="s1",
        message="High temperature warning",
        severity=AlertSeverity.WARNING,
    )
    assert alert.status == AlertStatus.OPEN
    assert alert.acknowledged_at is None
    assert alert.resolved_at is None

                 
    ack_alert = alert_svc.acknowledge_alert(alert.id)
    assert ack_alert is not None
    assert ack_alert.status == AlertStatus.ACKNOWLEDGED
    assert ack_alert.acknowledged_at is not None

             
    res_alert = alert_svc.resolve_alert(alert.id)
    assert res_alert is not None
    assert res_alert.status == AlertStatus.RESOLVED
    assert res_alert.resolved_at is not None

                              
    assert len(alert_svc.get_open_alerts()) == 0


</source-code>
              </source-codes>
            </operation>
            <operation id="o2a99535dbe8b4734af81fe29bb08fc1e586" cid="OP016" name="test_notification_delivery_dispatch" creation-date="10/09/2026 22:14:36" type="" type-id="" visibility="public">
              <tagged-values>
                <tagged-value id="tv81e4a0f833ce486cac131b02f86ca390" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_notification_delivery_dispatch" />
                <tagged-value id="tv259b89c3bc734356a3b8c20fc92c5e7b" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_monitoring.py" />
