                <operation id="o6fb6412ce58e46ac943102a121f62de1428" cid="OP015" name="test_alert_lifecycle_workflow" creation-date="10/09/2026 22:07:56" type="" type-id="" visibility="public">
                  <parameters>
                    <parameter id="p1a95f738987f45b388cb083c3aa0d161" name="test_setup" type="" type-id="" creation-date="10/09/2026 22:07:56" />
                  </parameters>
                  <tagged-values>
                    <tagged-value id="tv5e03f0c491fb481aba898875650cbe38" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_alert_lifecycle_workflow" />
                    <tagged-value id="tv2b5a2ff1b8904e0e973a12f2de4872ad" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_monitoring.py" />
                    <tagged-value id="tvbc25fdf1568a40ee8ed68b4ee91e1549" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tvfcfd52dbc057467fb30c0d89112bd5ab" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="3411" />
                    <tagged-value id="tv12abb54bf86c48eaa58f142f1b3e2730" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="912" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                               
    alert_svc = test_setup["alert_svc"]
    alert = alert_svc.create_alert(
        sensor_id="s1",
        message="High temperature warning",
        severity=AlertSeverity.WARNING,
    )
    assert alert.status == AlertStatus.OPEN
    assert alert.acknowledged_at is None
    assert alert.resolved_at is None

                 
    ack_alert = alert_svc.acknowledge_alert(alert.id)
    assert ack_alert is not None
    assert ack_alert.status == AlertStatus.ACKNOWLEDGED
    assert ack_alert.acknowledged_at is not None

             
    res_alert = alert_svc.resolve_alert(alert.id)
    assert res_alert is not None
    assert res_alert.status == AlertStatus.RESOLVED
    assert res_alert.resolved_at is not None

                              
    assert len(alert_svc.get_open_alerts()) == 0


</source-code>
                  </source-codes>
                </operation>
                <operation id="o7cddcbbb1cbe4222a1ee31328a7a7b7b428" cid="OP016" name="test_notification_delivery_dispatch" creation-date="10/09/2026 22:07:56" type="" type-id="" visibility="public">
