            <operation id="ofc6b33aa47ea4ca8b063fbafb0f03cc2586" cid="OP017" name="test_detect_offline_sensor" creation-date="10/09/2026 22:14:36" type="" type-id="" visibility="public">
              <parameters>
                <parameter id="pda4690ab5a084a418b2665da27cd2409" name="test_setup" type="" type-id="" creation-date="10/09/2026 22:14:36" />
              </parameters>
              <tagged-values>
                <tagged-value id="tva0c37ea4be1f492295b0bbbd41ebb626" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_detect_offline_sensor" />
                <tagged-value id="tv8082e44bdb4f4b7b9586a5e31683379b" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_monitoring.py" />
                <tagged-value id="tv71c2d4fa68574070b1b1181f7b4788ef" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                <tagged-value id="tv0b9ac1aa590d4628a96750ca732e04e0" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="5049" />
                <tagged-value id="tv45e98f89d9dc45c6a7909eb34cf07724" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="904" />
              </tagged-values>
              <source-codes>
                <source-code language="Python">                                                                                 
    sensor_repo = test_setup["sensor_repo"]
    monitoring_svc = test_setup["monitoring_svc"]

                                      
    s1 = TemperatureSensor(id="s1", name="Active Sensor")
    s1.last_reading_time = datetime.now()
    sensor_repo.add(s1)

                                                         
    s2 = TemperatureSensor(id="s2", name="Dead Sensor")
    s2.last_reading_time = datetime.now() - timedelta(minutes=10)
    sensor_repo.add(s2)

    alerts = monitoring_svc.detect_offline_sensor(timeout_seconds=300.0)
    assert len(alerts) == 1
    assert alerts[0].sensor_id == "s2"
    assert alerts[0].severity == AlertSeverity.CRITICAL

                                            
    assert sensor_repo.get_by_id("s2").status == SensorStatus.OFFLINE


</source-code>
              </source-codes>
            </operation>
            <operation id="oc81bcec4b8be4deb85fc838414ce5d5d586" cid="OP018" name="test_reporting_service_aggregations" creation-date="10/09/2026 22:14:36" type="" type-id="" visibility="public">
              <parameters>
                <parameter id="pa76076f3d3b3402cad89012995d3c81c" name="test_setup" type="" type-id="" creation-date="10/09/2026 22:14:36" />
              </parameters>
              <tagged-values>
                <tagged-value id="tv6a23b44436ce45308b194c64b8d2a008" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_reporting_service_aggregations" />
                <tagged-value id="tv7dbd4ae6977a45e0a1f7a945bafc9d66" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_monitoring.py" />
                <tagged-value id="tv0f81065a80a44a4aaaab84bda3fec318" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                <tagged-value id="tv73b1d270307e471f98e366bbc199bb8f" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="5953" />
                <tagged-value id="tv0f0204a523ba4fdb910c934261b7cdb1" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="1384" />
              </tagged-values>
              <source-codes>
                <source-code language="Python">                                                                          
    sensor_repo = test_setup["sensor_repo"]
    reading_repo = test_setup["reading_repo"]
    reporting_svc = test_setup["reporting_svc"]

    sensor = TemperatureSensor(id="s_stat", name="Stat Temp Sensor")
    sensor_repo.add(sensor)

    reading_repo.add(SensorReading("r1", "s_stat", datetime.now(), 20.0, "C"))
    reading_repo.add(SensorReading("r2", "s_stat", datetime.now(), 30.0, "C"))
    reading_repo.add(SensorReading("r3", "s_stat", datetime.now(), 25.0, "C"))

    assert reporting_svc.calculate_min_reading("s_stat") == 20.0
    assert reporting_svc.calculate_max_reading("s_stat") == 30.0
    assert reporting_svc.calculate_average_reading("s_stat") == 25.0

                   
    sensor_rep = reporting_svc.generate_sensor_report("s_stat")
    assert sensor_rep["sensor_id"] == "s_stat"
    assert sensor_rep["total_readings"] == 3

                     
    bldg = Building("b1", "Alpha Center", "10 Innovation Blvd")
    fl = Floor("f1", 1)
    rm = Room("r1", "Main Hall", 1)
    rm.add_sensor(sensor)
    fl.add_room(rm)
    bldg.add_floor(fl)

    bldg_rep = reporting_svc.generate_building_report(bldg)
    assert bldg_rep["building_id"] == "b1"
    assert bldg_rep["total_sensors"] == 1
    assert bldg_rep["online_sensors"] == 1
</source-code>
              </source-codes>
            </operation>
          </operations>
