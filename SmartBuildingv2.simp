                <operation id="of736d52e970e4f828b126373c840e54f63" cid="OP008" name="test_in_memory_repository_crud" creation-date="10/10/2026 07:40:06" type="" type-id="" visibility="public">
                  <tagged-values>
                    <tagged-value id="tv5f95d42cfd514c96a83f80258f495f82" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_in_memory_repository_crud" />
                    <tagged-value id="tve78d1b71674b4b51be9ebb7c561570ac" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_repositories.py" />
                    <tagged-value id="tvb01565c7e1c84033bb43bbda56cdf54c" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tvff9e416af9254f6b9f10bedb272b7c21" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="585" />
                    <tagged-value id="tv4181d1b0a18e4728a7da4b2b9fc0c445" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="982" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                             
    repo = InMemoryRepository[TemperatureSensor]()
    sensor1 = TemperatureSensor(id="s1", name="Sensor One")
    sensor2 = TemperatureSensor(id="s2", name="Sensor Two")

         
    repo.add(sensor1)
    repo.add(sensor2)
    assert repo.count() == 2

               
    fetched = repo.get_by_id("s1")
    assert fetched == sensor1
    assert repo.get_by_id("non-existent") is None

             
    all_sensors = repo.get_all()
    assert len(all_sensors) == 2
    assert sensor1 in all_sensors

            
    sensor1.name = "Sensor One Renamed"
    updated = repo.update(sensor1)
    assert updated is True
    assert repo.get_by_id("s1").name == "Sensor One Renamed"

            
    deleted = repo.delete("s1")
    assert deleted is True
    assert repo.get_by_id("s1") is None
    assert repo.count() == 1

           
    repo.clear()
    assert repo.count() == 0


</source-code>
                  </source-codes>
                </operation>
                <operation id="o966071afcbe8450d8ef1e7b451c9fc2663" cid="OP009" name="test_sensor_repository_queries" creation-date="10/10/2026 07:40:06" type="" type-id="" visibility="public">
                  <tagged-values>
                    <tagged-value id="tv3913b57c704f49d690fd3ec5aae430f1" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_sensor_repository_queries" />
                    <tagged-value id="tvb37ee7b7029143d687958685aa668938" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_repositories.py" />
                    <tagged-value id="tv19518a2e191645d79e2d1eab9da16024" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tv0f9062c431c844ebbbb72c3a1bd0074a" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="1567" />
                    <tagged-value id="tv9fff7ddbe03146f597e5a046661788d2" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="856" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                          
    repo = SensorRepository()
    s1 = TemperatureSensor(id="s1", name="Room A Temp", room_id="rm-A")
    s2 = TemperatureSensor(id="s2", name="Room B Temp", room_id="rm-B")
    s3 = TemperatureSensor(id="s3", name="Room A Backup", room_id="rm-A")
    s3.status = SensorStatus.OFFLINE

    repo.add(s1)
    repo.add(s2)
    repo.add(s3)

                    
    room_a_sensors = repo.get_by_room_id("rm-A")
    assert len(room_a_sensors) == 2
    assert s1 in room_a_sensors
    assert s3 in room_a_sensors

                   
    offline_sensors = repo.get_by_status(SensorStatus.OFFLINE)
    assert len(offline_sensors) == 1
    assert offline_sensors[0] == s3

                                            
    assert repo.get_offline_sensors() == [s3]


</source-code>
                  </source-codes>
                </operation>
                <operation id="o0597468757104f13a03e54b90f19127c63" cid="OP010" name="test_reading_repository_queries" creation-date="10/10/2026 07:40:06" type="" type-id="" visibility="public">
                  <tagged-values>
                    <tagged-value id="tv4a7ec88eef86489db73cc69c26cd48c2" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_reading_repository_queries" />
                    <tagged-value id="tvef67189a2e02452abe97d1f57c6cbb33" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_repositories.py" />
                    <tagged-value id="tv7627d11fae514c4291ff83023fc2580d" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tva97134eb120942cc9c7f8616771c0386" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="2423" />
                    <tagged-value id="tv8a22c417e7604ad1963fc674beebe787" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="1122" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                           
    repo = ReadingRepository()
    t0 = datetime.now() - timedelta(minutes=10)
    t1 = datetime.now() - timedelta(minutes=5)
    t2 = datetime.now()

    r1 = SensorReading(id="r1", sensor_id="s1", timestamp=t0, value=20.0, unit="C")
    r2 = SensorReading(id="r2", sensor_id="s1", timestamp=t1, value=22.0, unit="C")
    r3 = SensorReading(id="r3", sensor_id="s1", timestamp=t2, value=25.0, unit="C")
    r4 = SensorReading(id="r4", sensor_id="s2", timestamp=t2, value=50.0, unit="%")

    repo.add(r1)
    repo.add(r2)
    repo.add(r3)
    repo.add(r4)

                      
    s1_readings = repo.get_by_sensor_id("s1")
    assert len(s1_readings) == 3

                        
    latest_s1 = repo.get_latest_reading("s1")
    assert latest_s1 is not None
    assert latest_s1.id == "r3"
    assert latest_s1.value == 25.0

                        
    recent = repo.get_readings_since("s1", since=datetime.now() - timedelta(minutes=7))
    assert len(recent) == 2
    assert r2 in recent
    assert r3 in recent


</source-code>
                  </source-codes>
                </operation>
                <operation id="o54943bf312694b488a20cfa20d5182c463" cid="OP011" name="test_alert_repository_queries" creation-date="10/10/2026 07:40:06" type="" type-id="" visibility="public">
                  <tagged-values>
                    <tagged-value id="tv63fe43b8f9e145dba7d7428a72d07dd1" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_alert_repository_queries" />
                    <tagged-value id="tv5703bd596e484b1d947f599e821935f8" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_repositories.py" />
                    <tagged-value id="tva712762fd9d54f939cfa6ab1b77cee05" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tv27cee97d9700404fbbb2c9717bf59fca" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="3545" />
                    <tagged-value id="tvc0b2e91bdeef4375897d726f3d0aef03" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="810" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                  
    repo = AlertRepository()
    a1 = Alert(id="a1", sensor_id="s1", message="Warning 1", severity=AlertSeverity.WARNING, status=AlertStatus.OPEN)
    a2 = Alert(id="a2", sensor_id="s1", message="Critical 1", severity=AlertSeverity.CRITICAL, status=AlertStatus.OPEN)
    a3 = Alert(id="a3", sensor_id="s2", message="Info 1", severity=AlertSeverity.INFO, status=AlertStatus.RESOLVED)

    repo.add(a1)
    repo.add(a2)
    repo.add(a3)

    assert len(repo.get_by_sensor_id("s1")) == 2
    assert len(repo.get_open_alerts()) == 2
    assert len(repo.get_by_severity(AlertSeverity.CRITICAL)) == 1
    assert repo.get_by_severity(AlertSeverity.CRITICAL)[0] == a2
    assert len(repo.get_by_status(AlertStatus.RESOLVED)) == 1
</source-code>
                  </source-codes>
                </operation>
                <operation id="o6baa876489124dd99f9e4509e09ce45764" cid="OP012" name="test_setup" creation-date="10/10/2026 07:40:06" type="" type-id="" visibility="public">
                  <tagged-values>
                    <tagged-value id="tv5b5c1db0713842138d6654efbc08ff8c" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_setup" />
                    <tagged-value id="tvf674064e55084514a91464f7cc948156" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_monitoring.py" />
                    <tagged-value id="tv258063ab3d764d5aaae62f4cd61f43d5" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tvc2febe6bd4154473ba50560255bf5611" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="916" />
                    <tagged-value id="tvc032dccd4caf4fe592cd66bf0ed5886f" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="1033" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                              
    sensor_repo = SensorRepository()
    reading_repo = ReadingRepository()
    alert_repo = AlertRepository()
    notification_svc = ConsoleNotificationService()
    alert_svc = AlertService(
        alert_repository=alert_repo,
        notification_service=notification_svc,
        notification_recipient="test-admin@building.local",
    )
    monitoring_svc = MonitoringService(
        sensor_repository=sensor_repo,
        reading_repository=reading_repo,
        alert_service=alert_svc,
    )
    reporting_svc = ReportingService(
        sensor_repository=sensor_repo,
        reading_repository=reading_repo,
        alert_repository=alert_repo,
    )
    return {
        "sensor_repo": sensor_repo,
        "reading_repo": reading_repo,
        "alert_repo": alert_repo,
        "notification_svc": notification_svc,
        "alert_svc": alert_svc,
        "monitoring_svc": monitoring_svc,
        "reporting_svc": reporting_svc,
    }


</source-code>
                  </source-codes>
                </operation>
