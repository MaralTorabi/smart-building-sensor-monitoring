              </tagged-values>
              <documentations>
                <doc id="a957255eb33541469900792d50684cac">
                  <text>
                    <default>
                      <style font-name="Verdana" font-size="12">
                        <text>
                          <solid-brush color="#FF000000" />
                        </text>
                      </style>
                    </default>
                    <styles />
                    <content>
                      <paragraph>
                        <style />
                        <p>
                          <t>"""Creates, stores, and optionally announces a new system alert.
</t>
                        </p>
                      </paragraph>
                      <paragraph>
                        <style />
                        <p>
                          <t>        Args:
</t>
                        </p>
                      </paragraph>
                      <paragraph>
                        <style />
                        <p>
                          <t>            sensor_id: Target sensor identifier.
</t>
                        </p>
                      </paragraph>
                      <paragraph>
                        <style />
                        <p>
                          <t>            message: Explanation of the alert condition.
</t>
                        </p>
                      </paragraph>
                      <paragraph>
                        <style />
                        <p>
                          <t>            severity: Severity level (INFO, WARNING, CRITICAL).
</t>
                        </p>
                      </paragraph>
                      <paragraph>
                        <style />
                        <p>
                          <t>            reading_id: Associated reading identifier.
</t>
                        </p>
                      </paragraph>
                      <paragraph>
                        <style />
                        <p>
                          <t>        Returns:
</t>
                        </p>
                      </paragraph>
                      <paragraph>
                        <style />
                        <p>
                          <t>            The created Alert instance.
</t>
                        </p>
                      </paragraph>
                      <paragraph>
                        <style />
                        <p>
                          <t>        """
</t>
                        </p>
                      </paragraph>
                    </content>
                  </text>
                </doc>
              </documentations>
              <feature static="true" />
            </item>
