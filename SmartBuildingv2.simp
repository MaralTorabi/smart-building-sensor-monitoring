                <operation id="o6be91074f7fc453f8a52fe861896b7dc62" cid="OP007" name="test_reading_validation_and_unit_conversion" creation-date="10/10/2026 07:40:06" type="" type-id="" visibility="public">
                  <tagged-values>
                    <tagged-value id="tv0733bca6199047bd99e0e7e98a839624" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_reading_validation_and_unit_conversion" />
                    <tagged-value id="tv12d955470b0a4e959c5b54392db2236c" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_sensors.py" />
                    <tagged-value id="tv1a6d0cd89b19456dbdd2e62f05b9514a" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tv4a5a5c8ac09440eb9f6a0ed556702ccc" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="3955" />
                    <tagged-value id="tv17f39a61cd75422f8507346bf8db3e65" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="933" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                                  
    valid_reading = SensorReading("r1", "t1", datetime.now(), 25.0, "C")
    assert valid_reading.is_valid() is True

                                                   
    f_val = valid_reading.convert_unit("F")
    assert round(f_val, 2) == 77.0

                                             
    k_val = valid_reading.convert_unit("K")
    assert round(k_val, 2) == 298.15

                               
    power_reading = SensorReading("r2", "e1", datetime.now(), 5.0, "kW")
    w_val = power_reading.convert_unit("W")
    assert w_val == 5000.0

                           
    nan_reading = SensorReading("r3", "t1", datetime.now(), float("nan"), "C")
    assert nan_reading.is_valid() is False

                            
    with pytest.raises(ValueError):
        valid_reading.convert_unit("meter")
</source-code>
