            <item id="923df79d891243c9b65b1dd821dd13bc" cid="C028" type="class" creation-date="10/10/2026 07:40:06">
              <operations>
                <operation id="o3a2e876f933643808f367c1eb9507ef060" cid="OP001" name="test_sensor_instantiation_and_inheritance" creation-date="10/10/2026 07:40:06" type="" type-id="" visibility="public">
                  <tagged-values>
                    <tagged-value id="tvb8a784f40ba24f2f8b7534ba21b48af9" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_sensor_instantiation_and_inheritance" />
                    <tagged-value id="tvd8944cf0802e43a283bdc3f59c70d3c2" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_sensors.py" />
                    <tagged-value id="tvca0ac9f0f5c84ac8a4dcf6452ee27167" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tva0f31a91e1e746a7ac73f42d2676a571" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="613" />
                    <tagged-value id="tv4fc1e724a17e49e6abdcf008948b97d6" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="713" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                                                                    
    temp_s = TemperatureSensor(id="t1", name="Temp 1")
    assert temp_s.id == "t1"
    assert temp_s.name == "Temp 1"
    assert temp_s.unit == "C"
    assert temp_s.status == SensorStatus.ONLINE
    assert temp_s.is_online() is True

    co2_s = CO2Sensor(id="c1", name="CO2 1")
    assert co2_s.unit == "ppm"

    hum_s = HumiditySensor(id="h1", name="Hum 1")
    assert hum_s.unit == "%"

    mot_s = MotionSensor(id="m1", name="Motion 1")
    assert mot_s.unit == "motion"

    eng_s = EnergySensor(id="e1", name="Energy 1")
    assert eng_s.unit == "kWh"


</source-code>
                  </source-codes>
                </operation>
                <operation id="o18ba461a279d482db3225048cf09512862" cid="OP002" name="test_sensor_state_transitions" creation-date="10/10/2026 07:40:06" type="" type-id="" visibility="public">
                  <tagged-values>
                    <tagged-value id="tvb54f0976481b46e6892496a9d164ce03" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_sensor_state_transitions" />
                    <tagged-value id="tv48b93f7160a64a09a9585dfc5e7fd05a" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_sensors.py" />
                    <tagged-value id="tva4607c916ee04ac7b5fb10d9b304f738" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tv9fd8b25c7b2045a98b6789ae22593dbb" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="1326" />
                    <tagged-value id="tv098f338e0468423ba55e78de041b619f" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="475" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                       
    sensor = TemperatureSensor(id="t1", name="Temp 1")
    assert sensor.is_online() is True

    sensor.disable()
    assert sensor.enabled is False
    assert sensor.status == SensorStatus.DISABLED
    assert sensor.is_online() is False

    sensor.enable()
    assert sensor.enabled is True
    assert sensor.status == SensorStatus.ONLINE
    assert sensor.is_online() is True


</source-code>
                  </source-codes>
                </operation>
                <operation id="ofd3e5c8904f34748a6898ec3697db3eb62" cid="OP003" name="test_room_and_sensor_association" creation-date="10/10/2026 07:40:06" type="" type-id="" visibility="public">
                  <tagged-values>
                    <tagged-value id="tvfefae9a6fa1e495abafc97831c13a538" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_room_and_sensor_association" />
                    <tagged-value id="tv8d827515b121487abee27b224236a0ba" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_sensors.py" />
                    <tagged-value id="tv3b92d78effcd4b76bb55e0fa1e6073c1" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tv7151a1c2fdcb48c286d4b2cc18537a0e" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="1801" />
                    <tagged-value id="tve5e561c685b44a1fb35b8fccad878be3" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="577" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                                                
    room = Room(id="rm-101", name="Lab A", floor_number=1)
    sensor = TemperatureSensor(id="t1", name="Lab Temp")

    assert sensor.room_id is None
    room.add_sensor(sensor)

    assert sensor in room.sensors
    assert sensor.room_id == "rm-101"
    assert room.get_sensor("t1") == sensor

                   
    removed = room.remove_sensor("t1")
    assert removed is True
    assert sensor.room_id is None
    assert sensor not in room.sensors


</source-code>
                  </source-codes>
                </operation>
                <operation id="o829217cb053e408090da477bead3161b62" cid="OP004" name="test_building_floor_room_hierarchy" creation-date="10/10/2026 07:40:06" type="" type-id="" visibility="public">
                  <tagged-values>
                    <tagged-value id="tv6ce971f8ef92499ab1633081b1e020d9" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_building_floor_room_hierarchy" />
                    <tagged-value id="tvda848c142b2a4b1fb556420727d18d11" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_sensors.py" />
                    <tagged-value id="tvf0bee85778004ab7a34b2bc835c59b8d" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tv50440925ac4e4999851c9faebf7b2453" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="2378" />
                    <tagged-value id="tv8dce62a7efa846ca9e007fe87c79f4d3" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="807" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                           
    bldg = Building(id="b1", name="Tower A", address="123 Tech St")
    fl1 = Floor(id="f1", number=1)
    rm1 = Room(id="r1", name="Server Room", floor_number=1)
    s1 = TemperatureSensor(id="s1", name="Rack Temp")
    s2 = HumiditySensor(id="s2", name="Rack Humidity")

    rm1.add_sensor(s1)
    rm1.add_sensor(s2)
    fl1.add_room(rm1)
    bldg.add_floor(fl1)

    assert fl1.building_id == "b1"
    assert rm1.floor_number == 1
    assert len(bldg.get_all_sensors()) == 2
    assert s1 in bldg.get_all_sensors()
    assert s2 in bldg.get_all_sensors()

                    
    assert fl1.remove_room("r1") is True
    assert fl1.get_room("r1") is None
    assert len(bldg.get_all_sensors()) == 0


</source-code>
                  </source-codes>
                </operation>
                <operation id="o8196bbbf2dac4867832d2f31c73f8dad62" cid="OP005" name="test_sensor_create_reading" creation-date="10/10/2026 07:40:06" type="" type-id="" visibility="public">
