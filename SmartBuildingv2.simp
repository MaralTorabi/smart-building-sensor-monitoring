                <operation id="o7988fc276f034e5cbf757ec80c9d1b2e66" cid="OP015" name="test_alert_lifecycle_workflow" creation-date="10/10/2026 07:40:06" type="" type-id="" visibility="public">
                  <parameters>
                    <parameter id="pd806f0df91e949b0a04cbd68f0d31594" name="test_setup" type="" type-id="" creation-date="10/10/2026 07:40:06" />
                  </parameters>
                  <tagged-values>
                    <tagged-value id="tv117d22253ef740c6a96655e72c799de2" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_alert_lifecycle_workflow" />
                    <tagged-value id="tv79bf6f0534994f0bbb29ee891c3870b8" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_monitoring.py" />
                    <tagged-value id="tvf9223689fdb04d9a801c95f1f950b34b" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tv2f5458b3c2904ab582a11a0399193263" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="3411" />
                    <tagged-value id="tvb4aea5f820924c42a14a5c7dbb4a7c5f" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="912" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                               
    alert_svc = test_setup["alert_svc"]
    alert = alert_svc.create_alert(
        sensor_id="s1",
        message="High temperature warning",
        severity=AlertSeverity.WARNING,
    )
    assert alert.status == AlertStatus.OPEN
    assert alert.acknowledged_at is None
    assert alert.resolved_at is None

                 
    ack_alert = alert_svc.acknowledge_alert(alert.id)
    assert ack_alert is not None
    assert ack_alert.status == AlertStatus.ACKNOWLEDGED
    assert ack_alert.acknowledged_at is not None

             
    res_alert = alert_svc.resolve_alert(alert.id)
    assert res_alert is not None
    assert res_alert.status == AlertStatus.RESOLVED
    assert res_alert.resolved_at is not None

                              
    assert len(alert_svc.get_open_alerts()) == 0


</source-code>
                  </source-codes>
                </operation>
                <operation id="o78d764a1187b41039d9abfe2a5dd1c7366" cid="OP016" name="test_notification_delivery_dispatch" creation-date="10/10/2026 07:40:06" type="" type-id="" visibility="public">
