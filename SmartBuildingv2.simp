                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                                           
    alert_repo = AlertRepository()
    email_svc = EmailNotificationService(sender_email="alerts@test.local")
    alert_svc = AlertService(
        alert_repository=alert_repo,
        notification_service=email_svc,
        notification_recipient="ops@test.local",
    )

    alert_svc.create_alert(
        sensor_id="s99",
        message="Critical leak detected",
        severity=AlertSeverity.CRITICAL,
    )
    assert len(email_svc.sent_emails) == 1
    assert email_svc.sent_emails[0]["to"] == "ops@test.local"
    assert email_svc.sent_emails[0]["subject"] == "[CRITICAL] Building Sensor Alert"


</source-code>
                  </source-codes>
                </operation>
                <operation id="oc7cff0e0eff34b3596e2a5db12aae76c66" cid="OP017" name="test_detect_offline_sensor" creation-date="10/10/2026 07:40:06" type="" type-id="" visibility="public">
                  <parameters>
                    <parameter id="p00012e5a07864fe1804e380016fdcd1c" name="test_setup" type="" type-id="" creation-date="10/10/2026 07:40:06" />
                  </parameters>
                  <tagged-values>
                    <tagged-value id="tv9ffbb17b0e6d45d1b261acc0b4aae55d" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_detect_offline_sensor" />
                    <tagged-value id="tv47cf7ea07a07483b932aaa89c1b43cf2" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_monitoring.py" />
                    <tagged-value id="tvb26d05f538424cf9ba5610c01ba67c76" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tvaa65dd19d9e34c27b69fb9dc317a478c" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="5049" />
                    <tagged-value id="tv808364e18713497984448b4f8346a878" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="904" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                                                 
    sensor_repo = test_setup["sensor_repo"]
    monitoring_svc = test_setup["monitoring_svc"]

                                      
    s1 = TemperatureSensor(id="s1", name="Active Sensor")
    s1.last_reading_time = datetime.now()
    sensor_repo.add(s1)

                                                         
    s2 = TemperatureSensor(id="s2", name="Dead Sensor")
    s2.last_reading_time = datetime.now() - timedelta(minutes=10)
    sensor_repo.add(s2)

    alerts = monitoring_svc.detect_offline_sensor(timeout_seconds=300.0)
    assert len(alerts) == 1
    assert alerts[0].sensor_id == "s2"
    assert alerts[0].severity == AlertSeverity.CRITICAL

                                            
    assert sensor_repo.get_by_id("s2").status == SensorStatus.OFFLINE


</source-code>
                  </source-codes>
                </operation>
                <operation id="oe78962e2dbdf4f0ea14bb00f63374e0366" cid="OP018" name="test_reporting_service_aggregations" creation-date="10/10/2026 07:40:06" type="" type-id="" visibility="public">
                  <parameters>
                    <parameter id="pd7d4643cd8784fd5a4b31ec0d13a776e" name="test_setup" type="" type-id="" creation-date="10/10/2026 07:40:06" />
                  </parameters>
                  <tagged-values>
                    <tagged-value id="tv3a5364e4ff6849dd941ba8f5ee3f6fe3" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="test_reporting_service_aggregations" />
                    <tagged-value id="tv413d2a8f073b4d5585dbca1ad8e39915" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\maral\Desktop\university\seventh semester\Software Design\project_1_40213312\smart_building\tests\test_monitoring.py" />
                    <tagged-value id="tvf57e6aa47f8743c4a0592ee54feab588" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="Python" />
                    <tagged-value id="tv52596bf037b0476c8192ded221b4322a" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="5953" />
                    <tagged-value id="tv5628243787ff428ab4ef99dc306654a8" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="1384" />
                  </tagged-values>
                  <source-codes>
                    <source-code language="Python">                                                                          
    sensor_repo = test_setup["sensor_repo"]
    reading_repo = test_setup["reading_repo"]
    reporting_svc = test_setup["reporting_svc"]

    sensor = TemperatureSensor(id="s_stat", name="Stat Temp Sensor")
    sensor_repo.add(sensor)

    reading_repo.add(SensorReading("r1", "s_stat", datetime.now(), 20.0, "C"))
    reading_repo.add(SensorReading("r2", "s_stat", datetime.now(), 30.0, "C"))
    reading_repo.add(SensorReading("r3", "s_stat", datetime.now(), 25.0, "C"))

    assert reporting_svc.calculate_min_reading("s_stat") == 20.0
    assert reporting_svc.calculate_max_reading("s_stat") == 30.0
    assert reporting_svc.calculate_average_reading("s_stat") == 25.0

                   
    sensor_rep = reporting_svc.generate_sensor_report("s_stat")
    assert sensor_rep["sensor_id"] == "s_stat"
    assert sensor_rep["total_readings"] == 3

                     
    bldg = Building("b1", "Alpha Center", "10 Innovation Blvd")
    fl = Floor("f1", 1)
    rm = Room("r1", "Main Hall", 1)
    rm.add_sensor(sensor)
    fl.add_room(rm)
    bldg.add_floor(fl)

    bldg_rep = reporting_svc.generate_building_report(bldg)
    assert bldg_rep["building_id"] == "b1"
    assert bldg_rep["total_sensors"] == 1
    assert bldg_rep["online_sensors"] == 1
</source-code>
                  </source-codes>
                </operation>
              </operations>
            </item>
